# keybind-whisper configuration
#
# Copy to ~/.config/keybind-whisper/config and edit. This file is sourced by the
# shell, so use `name=value`. Every setting is optional: the defaults below are
# what the tool uses when the file is absent. Environment variables override it.

# ── Input device ────────────────────────────────────────────────────────────
# Leave unset (the default) to record from whatever macOS has set as the system
# default input. This is the recommended setting: dictation then follows the
# device you pick in System Settings > Sound, like any other app.
# Set it only to pin one specific device regardless of the system default. Use
# the exact name shown by `keybind-whisper doctor`.
# KEYBIND_DEVICE="USB Audio CODEC"

# ── Model and language ──────────────────────────────────────────────────────
# By default the best usable ggml model found is used. The shared store below
# is searched first, then the usual whisper.cpp and Homebrew locations. Set
# this to pin one specific file and skip discovery entirely.
# KEYBIND_MODEL="$HOME/.cauldron/.models/whisper-large-v3-turbo/ggml-large-v3-turbo.bin"

# Shared model store: one directory per model, so weights live in one place on
# the machine instead of a multi-gigabyte copy per project. The directory name
# inside is arbitrary; only the ggml-*.bin file matters.
#   ~/.cauldron/.models/whisper-large-v3-turbo/ggml-large-v3-turbo.bin
# Selection is by model quality first and location second, so a better model
# elsewhere still wins. `keybind-whisper models` shows what was found.
# KEYBIND_MODELS_DIR="$HOME/.cauldron/.models"

# Spoken language, as an ISO 639-1 code. Use "auto" to detect it per recording,
# at some cost in accuracy and speed.
# KEYBIND_LANG="en"

# Decoding threads. Defaults to whisper.cpp's own choice.
# KEYBIND_THREADS="8"

# ── Silence detection ───────────────────────────────────────────────────────
# A capture below BOTH of these is treated as silence and never sent to the
# model, because whisper invents plausible filler when given silent audio.
# Lower them if a genuinely quiet microphone is being rejected; raise them if
# room noise is getting transcribed. `keybind-whisper doctor` prints the levels
# your microphone actually produces.
# KEYBIND_PEAK_MIN="0.0008"
# KEYBIND_RMS_MIN="0.0006"

# ── Limits ──────────────────────────────────────────────────────────────────
# Captures shorter than this are treated as a fumbled keypress, in seconds.
# KEYBIND_MIN_SEC="0.30"

# Recording stops on its own after this many seconds, so a forgotten recording
# cannot fill the disk.
# KEYBIND_MAX_SEC="1800"

# ── Backend: where transcription actually runs ──────────────────────────────
# cli     (default) spawn whisper-cli per utterance. Nothing to run, works
#         offline, cannot be misconfigured — and reloads the whole model every
#         single time, which is over half the latency of a short dictation.
# server  POST to a local whisper-server holding the model resident. Same
#         machine, same weights, roughly 3.7x faster. Start it with:
#           keybind-whisper serve
# api     POST to an OpenAI-shaped endpoint. THIS UPLOADS YOUR AUDIO unless the
#         URL is local. Never chosen automatically, never used as a fallback.
# KEYBIND_BACKEND="cli"

# Where `server` dials, and where `keybind-whisper serve` listens.
# KEYBIND_SERVER_URL="http://127.0.0.1:8080"

# An unreachable local server falls back to the local CLI by default: both are
# on this machine, and losing dictation you already spoke helps nobody. The
# fallback is logged and `doctor` reports the server as down. Set to 0 to make
# an unreachable server a hard error instead.
# KEYBIND_SERVER_FALLBACK="1"

# Any endpoint implementing POST /v1/audio/transcriptions.
# KEYBIND_API_URL="https://api.openai.com/v1/audio/transcriptions"
# Required unless the endpoint is on localhost. Passed to curl through a
# mode-0600 config file, never on the command line, and redacted from the log.
# KEYBIND_API_KEY=""
# KEYBIND_API_MODEL="whisper-1"
# KEYBIND_HTTP_TIMEOUT="120"

# ── Auto-stop on silence ────────────────────────────────────────────────────
# Seconds of silence that end a recording. 0 (the default) means push-to-talk:
# recording ends when you say it does.
# KEYBIND_SILENCE_SEC="0"

# Amplitude below which audio counts as silence, as a percentage of full scale.
# It has to sit above your room noise and below your speech: too high and quiet
# speech never registers, too low and room noise never counts as a pause. Run
# `keybind-whisper doctor` — it measures both and recommends a value.
# KEYBIND_SILENCE_THRESHOLD="2%"

# ── Vocabulary and replacements ─────────────────────────────────────────────
# Two files, both optional, fixing different failures.
#
# vocabulary   one term per line, fed to the model as an initial prompt so
#              decoding leans toward your proper nouns and jargon. Works when
#              the model is close; it is a nudge, not a guarantee.
#
# replacements `find = replace` per line, applied after transcription. Literal,
#              case-insensitive, whole-word. Rules are tried in file order and
#              the first match wins, so list longer phrases before shorter ones
#              they contain. An empty replacement deletes the term.
#              Preview with: keybind-whisper replace "some text"
#
# KEYBIND_VOCAB_FILE="$HOME/.config/keybind-whisper/vocabulary"
# KEYBIND_REPLACEMENTS_FILE="$HOME/.config/keybind-whisper/replacements"

# ── History ─────────────────────────────────────────────────────────────────
# Every successful transcription is stored so it can be searched and reused.
# This is dictated text, so treat the file as sensitive: it is written 0600
# inside a 0700 directory and never leaves the machine.

# Set to 0 to store nothing at all. No file is created.
# KEYBIND_HISTORY="1"

# KEYBIND_HISTORY_FILE="$HOME/.local/share/keybind-whisper/history.jsonl"

# Entries kept before the oldest are dropped.
# KEYBIND_HISTORY_MAX="1000"

# ── Paths ───────────────────────────────────────────────────────────────────
# Override only if the tool cannot find these on its own.
# KEYBIND_SOX="/opt/homebrew/bin/sox"
# KEYBIND_WHISPER_BIN="$HOME/code/whisper.cpp/build/bin/whisper-cli"
# KEYBIND_LOG="$HOME/Library/Logs/keybind-whisper.log"
