#!/usr/bin/env bash
#
# keybound-whisper — local, offline push-to-talk dictation for macOS.
#
# Records from the system default input, transcribes with whisper.cpp, and
# prints the text to stdout. Nothing leaves the machine.
#
#   keybound-whisper start            begin recording (backgrounded)
#   keybound-whisper stop             finish recording, print the transcript
#   keybound-whisper toggle           start if idle, stop if recording
#   keybound-whisper transcribe FILE  transcribe an existing audio file
#   keybound-whisper status           report current state and resolved config
#   keybound-whisper doctor           check dependencies and test the microphone
#   keybound-whisper version          print the version
#
# ── Output contract ─────────────────────────────────────────────────────────
# Callers depend on this; do not weaken it.
#
#   exit 0, stdout non-empty : the transcript
#   exit 0, stdout empty     : nothing usable was heard; stderr says why
#   exit non-zero            : a real failure; stderr carries the message
#
# stdout is ONLY ever the transcript, so a caller can paste it blind. Every
# diagnostic goes to stderr and to the log.
#
# ── Never rely on PATH ──────────────────────────────────────────────────────
# This is designed to be driven by a GUI hotkey daemon. Processes spawned by
# macOS LaunchServices inherit PATH=/usr/bin:/bin:/usr/sbin:/sbin, which does
# not include Homebrew. A bare `sox` resolves fine in a login shell and fails
# with 127 under a GUI app — producing an empty transcript on every run, with
# the error swallowed. Every external binary here is resolved explicitly.
#
# Targets bash 3.2, the version macOS ships. No bash 4+ syntax.

# Deliberately not `set -e`: this tool's job is to always explain itself, so
# errors are handled explicitly rather than exiting silently mid-pipeline.
set -uo pipefail

KEYBOUND_VERSION="1.0.0"

# ── Configuration ───────────────────────────────────────────────────────────
# Every setting is an environment variable with a safe default. An optional
# config file can set any of them; the environment still wins.
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_FILE="${KEYBOUND_CONFIG:-$CONFIG_HOME/keybound-whisper/config}"
# shellcheck source=/dev/null
[ -r "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# Input device. EMPTY IS THE DEFAULT AND THE RECOMMENDED SETTING: it records
# from whatever macOS has set as the system default input, so the tool follows
# the OS the way every other app does. Set it only to pin one specific device.
DEVICE="${KEYBOUND_DEVICE:-}"

LANG_CODE="${KEYBOUND_LANG:-en}"
THREADS="${KEYBOUND_THREADS:-}"

# Dead-stream thresholds. Raise if your mic is hot, lower if it is very quiet.
PEAK_MIN="${KEYBOUND_PEAK_MIN:-0.0008}"
RMS_MIN="${KEYBOUND_RMS_MIN:-0.0006}"
# Shortest capture worth transcribing; below this it is a fumbled keypress.
MIN_SEC="${KEYBOUND_MIN_SEC:-0.30}"
# Hard cap so a forgotten recording cannot run until the disk fills. sox closes
# the file cleanly and exits on its own when it reaches this.
MAX_SEC="${KEYBOUND_MAX_SEC:-1800}"

# ── History ─────────────────────────────────────────────────────────────────
# Every successful transcription is appended to a JSONL file so past dictation
# can be found and reused. This is dictated text: treat it as sensitive. The
# file is created 0600 inside a 0700 directory, and history can be turned off
# entirely by setting KEYBOUND_HISTORY=0.
HISTORY_ENABLED="${KEYBOUND_HISTORY:-1}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
HISTORY_FILE="${KEYBOUND_HISTORY_FILE:-$DATA_HOME/keybound-whisper/history.jsonl}"
# Entries kept. Older ones are dropped as new ones arrive.
HISTORY_MAX="${KEYBOUND_HISTORY_MAX:-1000}"

# ── Auto-stop on silence ────────────────────────────────────────────────────
# Seconds of silence that end a recording. 0 disables it, which is the default:
# the tool is push-to-talk, so recording normally ends when you say it does.
# When enabled, `dictate` records until you stop speaking.
SILENCE_SEC="${KEYBOUND_SILENCE_SEC:-0}"
# Amplitude below which audio counts as silence, as a percentage of full scale.
# Must sit above your room noise and below your speech. `doctor` measures both
# and prints a recommendation.
SILENCE_THRESHOLD="${KEYBOUND_SILENCE_THRESHOLD:-2%}"

# ── Vocabulary and replacements ─────────────────────────────────────────────
# Two separate mechanisms, because they fix different failures.
#
# vocabulary   terms fed to the model as an initial prompt, which biases
#              decoding toward them. Catches proper nouns before they are
#              mistranscribed, but is a nudge, not a guarantee.
# replacements literal find-and-replace applied after transcription. Catches
#              what the model gets wrong anyway, deterministically.
VOCAB_FILE="${KEYBOUND_VOCAB_FILE:-$CONFIG_HOME/keybound-whisper/vocabulary}"
REPLACEMENTS_FILE="${KEYBOUND_REPLACEMENTS_FILE:-$CONFIG_HOME/keybound-whisper/replacements}"

# Per-user state directory. Not $TMPDIR: macOS gives each process context a
# different private $TMPDIR, so `start` and `stop` would not agree on a path.
STATE_DIR="${KEYBOUND_STATE_DIR:-/tmp/keybound-whisper-$(id -u)}"
mkdir -p "$STATE_DIR" 2>/dev/null
chmod 700 "$STATE_DIR" 2>/dev/null

WAV="$STATE_DIR/capture.wav"
NORM="$STATE_DIR/capture.norm.wav"
PIDFILE="$STATE_DIR/recorder.pid"
DEVFILE="$STATE_DIR/device"
TRANSCRIBING="$STATE_DIR/transcribing"
LOG="${KEYBOUND_LOG:-$STATE_DIR/keybound-whisper.log}"

# Core utilities, pinned. All are in the restricted GUI PATH.
DATE="/bin/date"; AWK="/usr/bin/awk"; SED="/usr/bin/sed"; TR="/usr/bin/tr"; PS="/bin/ps"

# ── Output helpers ──────────────────────────────────────────────────────────
log() {
    # Keep the log from growing without bound across months of daily use.
    if [ -f "$LOG" ]; then
        sz=$(/usr/bin/stat -f%z "$LOG" 2>/dev/null || echo 0)
        [ "$sz" -gt 1048576 ] && mv -f "$LOG" "$LOG.1" 2>/dev/null
    fi
    printf '%s %s\n' "$("$DATE" '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG" 2>/dev/null
}

# Fatal: message on stderr and in the log, nothing on stdout, non-zero exit.
die() { log "ERROR: $*"; printf '%s\n' "$*" >&2; exit 1; }

# "Nothing usable": empty stdout, reason on stderr, exit 0.
nothing() { log "EMPTY: $*"; printf '%s\n' "$*" >&2; exit 0; }

# ── Dependency resolution (never trusts PATH) ───────────────────────────────
resolve_bin() {
    _name="$1"; shift
    for _c in "$@"; do
        [ -n "$_c" ] && [ -x "$_c" ] && { printf '%s\n' "$_c"; return 0; }
    done
    _c="$(command -v "$_name" 2>/dev/null)"
    [ -n "$_c" ] && [ -x "$_c" ] && { printf '%s\n' "$_c"; return 0; }
    return 1
}

SOX="${KEYBOUND_SOX:-$(resolve_bin sox \
    /opt/homebrew/bin/sox /usr/local/bin/sox)}"

# whisper.cpp's CLI is `whisper-cli`; older builds called it `main`.
WHISPER="${KEYBOUND_WHISPER_BIN:-$(resolve_bin whisper-cli \
    /opt/homebrew/bin/whisper-cli /usr/local/bin/whisper-cli \
    "$HOME/code/whisper.cpp/build/bin/whisper-cli" \
    "$HOME/whisper.cpp/build/bin/whisper-cli" \
    "$HOME/src/whisper.cpp/build/bin/whisper-cli")}"

# Optional: only used to name and list audio devices in `doctor`.
SWITCHAUDIO="${KEYBOUND_SWITCHAUDIO:-$(resolve_bin SwitchAudioSource \
    /opt/homebrew/bin/SwitchAudioSource /usr/local/bin/SwitchAudioSource)}"

# Model discovery: an explicit setting wins, otherwise search the usual places
# in descending order of quality so a fresh install just works.
find_model() {
    [ -n "${KEYBOUND_MODEL:-}" ] && { printf '%s\n' "$KEYBOUND_MODEL"; return 0; }
    _dirs="${XDG_DATA_HOME:-$HOME/.local/share}/keybound-whisper/models
$HOME/.local/share/keybound-whisper/models
$HOME/code/whisper.cpp/models
$HOME/whisper.cpp/models
$HOME/src/whisper.cpp/models
/opt/homebrew/share/whisper-cpp/models
/usr/local/share/whisper-cpp/models"
    _names="ggml-large-v3-turbo.bin ggml-large-v3.bin ggml-large-v2.bin
ggml-medium.en.bin ggml-medium.bin ggml-small.en.bin ggml-small.bin
ggml-base.en.bin ggml-base.bin ggml-tiny.en.bin ggml-tiny.bin"
    for _n in $_names; do
        for _d in $_dirs; do
            [ -f "$_d/$_n" ] && { printf '%s\n' "$_d/$_n"; return 0; }
        done
    done
    return 1
}
MODEL="$(find_model)"

require_sox() {
    [ -n "$SOX" ] || die "sox not found. Install it: brew install sox"
}
require_whisper() {
    [ -n "$WHISPER" ] || die "whisper-cli not found. Install whisper.cpp, or set KEYBOUND_WHISPER_BIN."
    [ -n "$MODEL" ] && [ -f "$MODEL" ] || die "no whisper model found. Download one and set KEYBOUND_MODEL."
}

# ── Recorder process management ─────────────────────────────────────────────
# True only when $1 is a live pid that really is one of our recorders, so a
# recycled pid can never be signalled by mistake.
recorder_alive() {
    _pid="${1:-}"
    [ -n "$_pid" ] || return 1
    case "$_pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$_pid" 2>/dev/null || return 1
    case "$("$PS" -o command= -p "$_pid" 2>/dev/null)" in *sox*) return 0 ;; *) return 1 ;; esac
}

current_pid() { cat "$PIDFILE" 2>/dev/null; }

# SIGINT first so sox writes a valid WAV trailer; escalate only if it refuses.
stop_recorder() {
    [ -f "$PIDFILE" ] || return 0
    _pid="$(current_pid)"
    if recorder_alive "$_pid"; then
        log "stopping recorder pid=$_pid"
        kill -INT "$_pid" 2>/dev/null
        _i=0
        while [ "$_i" -lt 100 ]; do
            recorder_alive "$_pid" || break
            /bin/sleep 0.05
            _i=$((_i + 1))
        done
        if recorder_alive "$_pid"; then
            log "pid=$_pid ignored SIGINT after 5s; sending TERM"
            kill -TERM "$_pid" 2>/dev/null
            /bin/sleep 0.5
            recorder_alive "$_pid" && { log "escalating to KILL"; kill -KILL "$_pid" 2>/dev/null; }
        fi
    else
        log "pidfile named pid=$_pid, which is not a live recorder; ignoring"
    fi
    rm -f "$PIDFILE"
}

# ── Audio helpers ───────────────────────────────────────────────────────────
# Print "<peak> <rms> <seconds>" for an audio file.
measure() {
    _s="$("$SOX" "$1" -n stat 2>&1)"
    _p="$(printf '%s\n' "$_s" | "$AWK" '/Maximum amplitude/{print $3; exit}')"
    _r="$(printf '%s\n' "$_s" | "$AWK" '/RMS +amplitude/{print $3; exit}')"
    _l="$(printf '%s\n' "$_s" | "$AWK" '/Length \(seconds\)/{print $3; exit}')"
    printf '%s %s %s\n' "${_p:-0}" "${_r:-0}" "${_l:-0}"
}

# ── History store ───────────────────────────────────────────────────────────
# Format is JSONL: one self-contained JSON object per line, newest last. It is
# append-only, greppable with ordinary tools, and trivial to export. Field
# order is fixed and `text` is always last, which is what lets the readers
# below extract it without a JSON parser.

# Escape a string for embedding in a JSON string literal. The text has already
# been flattened to a single line, so stripping control characters outright is
# safe and leaves only backslash and double quote to escape.
json_escape() {
    printf '%s' "$1" | "$TR" -d '\000-\037' | "$SED" -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Shared awk helper: reverse a JSON string escape. Done in awk rather than with
# sed placeholders so that backslashes in dictated text round-trip correctly.
AWK_UNESCAPE='
function unesc(s,   out, i, c, d) {
    out = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\\" && i < length(s)) {
            i++; d = substr(s, i, 1)
            out = out (d == "n" ? "\n" : (d == "t" ? "\t" : d))
        } else out = out c
    }
    return out
}
function field(line, key,   m) {
    m = line
    if (!sub("^.*\"" key "\":\"", "", m)) return ""
    sub("\".*$", "", m)
    return m
}
function textof(line,   m) {
    m = line
    if (!sub(/^.*"text":"/, "", m)) return ""
    sub(/"}[ \t]*$/, "", m)
    return unesc(m)
}
'

history_append() {
    [ "$HISTORY_ENABLED" = "1" ] || return 0
    _htext="$1"; _hsecs="$2"; _hpeak="$3"; _hrms="$4"; _hsrc="$5"

    _hdir="$(dirname "$HISTORY_FILE")"
    mkdir -p "$_hdir" 2>/dev/null || { log "history: cannot create $_hdir"; return 0; }
    chmod 700 "$_hdir" 2>/dev/null
    if [ ! -e "$HISTORY_FILE" ]; then
        : > "$HISTORY_FILE" 2>/dev/null || { log "history: cannot write $HISTORY_FILE"; return 0; }
    fi
    chmod 600 "$HISTORY_FILE" 2>/dev/null

    printf '{"ts":"%s","epoch":%s,"seconds":"%s","peak":"%s","rms":"%s","source":"%s","chars":%s,"text":"%s"}\n' \
        "$("$DATE" '+%Y-%m-%dT%H:%M:%S%z')" \
        "$("$DATE" '+%s')" \
        "$(json_escape "$_hsecs")" \
        "$(json_escape "$_hpeak")" \
        "$(json_escape "$_hrms")" \
        "$(json_escape "$_hsrc")" \
        "$(printf '%s' "$_htext" | /usr/bin/wc -c | "$TR" -d ' ')" \
        "$(json_escape "$_htext")" \
        >> "$HISTORY_FILE" 2>/dev/null || log "history: append failed"

    # Trim in batches rather than on every write, so a long history does not
    # mean rewriting the whole file after every sentence.
    _hcount="$(/usr/bin/wc -l < "$HISTORY_FILE" 2>/dev/null | "$TR" -d ' ')"
    if [ -n "$_hcount" ] && [ "$_hcount" -gt $((HISTORY_MAX + 100)) ]; then
        if tail -n "$HISTORY_MAX" "$HISTORY_FILE" > "$HISTORY_FILE.tmp" 2>/dev/null; then
            chmod 600 "$HISTORY_FILE.tmp" 2>/dev/null
            mv -f "$HISTORY_FILE.tmp" "$HISTORY_FILE"
            log "history: trimmed to $HISTORY_MAX entries"
        else
            rm -f "$HISTORY_FILE.tmp"
        fi
    fi
}

history_require() {
    [ -s "$HISTORY_FILE" ] || die "no history yet ($HISTORY_FILE)"
}

# Entry 1 is the most recent, counting backwards, which is how someone asks for
# "the last one" or "three back".
history_line_at() {
    _n="${1:-1}"
    case "$_n" in ''|*[!0-9]*) die "history index must be a number: $_n" ;; esac
    [ "$_n" -ge 1 ] || die "history index starts at 1"
    _total="$(/usr/bin/wc -l < "$HISTORY_FILE" | "$TR" -d ' ')"
    [ "$_n" -le "$_total" ] || die "no history entry $_n (only $_total stored)"
    tail -n "$_n" "$HISTORY_FILE" | head -n 1
}

# ── Vocabulary biasing ──────────────────────────────────────────────────────
# Join the vocabulary into one comma-separated initial prompt. whisper caps the
# prompt at n_text_ctx/2 tokens, so an oversized list is truncated rather than
# silently rejected by the model.
VOCAB_PROMPT_MAX="${KEYBOUND_VOCAB_PROMPT_MAX:-800}"
vocab_prompt() {
    [ -f "$VOCAB_FILE" ] || return 0
    _vp="$("$SED" -e 's/#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$VOCAB_FILE" \
        | "$AWK" 'NF { terms = terms (terms ? ", " : "") $0 } END { print terms }')"
    [ -n "$_vp" ] || return 0
    if [ "${#_vp}" -gt "$VOCAB_PROMPT_MAX" ]; then
        _vp="$(printf '%s' "$_vp" | cut -c "1-$VOCAB_PROMPT_MAX")"
        log "vocabulary: truncated the prompt to $VOCAB_PROMPT_MAX characters"
    fi
    # Framed as a sentence rather than passed as a bare comma list. whisper
    # imitates the prompt's style, so an unpunctuated fragment can cost you
    # capitalization and punctuation in the transcript; a well-formed sentence
    # biases the vocabulary without dragging the style along with it.
    printf 'The following terms may appear: %s.' "$_vp"
}

# ── Replacements ────────────────────────────────────────────────────────────
# Rules are `find = replace`, one per line, # for comments. Matching is literal
# and case-insensitive, and only fires on whole words, so a rule for "arm" can
# never rewrite the middle of "alarm". Literal rather than regex matching keeps
# the file safe to edit without knowing regex syntax; regex support is tracked
# in ROADMAP.md.
apply_replacements() {
    _rtext="$1"
    [ -s "$REPLACEMENTS_FILE" ] || { printf '%s' "$_rtext"; return 0; }
    printf '%s' "$_rtext" | "$AWK" -v rulefile="$REPLACEMENTS_FILE" '
        function is_word(c) { return c ~ /[A-Za-z0-9]/ }

        # Single left-to-right pass. At each position the rules are tried in
        # file order and the first whole-word match wins; the replacement is
        # emitted and the cursor jumps past the matched SOURCE text, so a
        # replacement is never re-examined. That matters: applying rules one
        # after another over the whole string instead would let them cascade,
        # so "cat = dog" followed by "dog = ferret" would yield "ferret" and
        # adding a rule could silently break an existing one.
        #
        # Matching uses substr() against a lowercased copy rather than a regex,
        # which makes it literal and case-insensitive: punctuation and regex
        # metacharacters in a rule mean exactly the characters they are.
        function apply_rules(text,   lt, out, pos, L, j, flen, before, after, ap, hit) {
            lt = tolower(text); L = length(text); out = ""; pos = 1
            while (pos <= L) {
                hit = 0
                for (j = 1; j <= n; j++) {
                    flen = flens[j]
                    if (flen == 0 || substr(lt, pos, flen) != lfinds[j]) continue
                    before = (pos == 1) ? "" : substr(text, pos - 1, 1)
                    ap = pos + flen
                    after = (ap > L) ? "" : substr(text, ap, 1)
                    if ((before == "" || !is_word(before)) && (after == "" || !is_word(after))) {
                        out = out repls[j]; pos += flen; hit = 1
                        break
                    }
                }
                if (!hit) { out = out substr(text, pos, 1); pos++ }
            }
            return out
        }

        BEGIN {
            n = 0
            while ((getline line < rulefile) > 0) {
                sub(/#.*$/, "", line)
                if (line !~ /=/) continue
                eq = index(line, "=")
                f = substr(line, 1, eq - 1)
                r = substr(line, eq + 1)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", f)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", r)
                if (f == "") continue
                n++; lfinds[n] = tolower(f); flens[n] = length(f); repls[n] = r
            }
            close(rulefile)
        }

        {
            out = apply_rules($0)
            # A rule whose replacement is empty leaves a gap behind, so
            # re-flatten whitespace the same way the raw transcript was.
            gsub(/[ \t]+/, " ", out)
            gsub(/^ +| +$/, "", out)
            printf "%s", out
        }
    '
}

history_text_at() {
    # die() inside a command substitution only exits the subshell, so the
    # failure has to be propagated explicitly or an invalid index would print
    # an error and still exit 0.
    _line="$(history_line_at "$1")" || exit 1
    printf '%s\n' "$_line" | "$AWK" "$AWK_UNESCAPE"'{print textof($0)}'
}

# Start sox in the background writing 16 kHz mono 16-bit — whisper's native
# format, so no resampling happens later. An empty $DEVICE means `-d`, the
# system default input.
# Sets REC_PID rather than printing it: a command substitution would put the
# background job inside a subshell, and `wait` in cmd_dictate could not reach it.
REC_PID=""
spawn_recorder() {
    # Effect chain. `trim 0 MAX_SEC` is the runaway guard. When auto-stop is on,
    # `silence` also ends the recording once speech stops: the first triple is
    # "begin after 0.1s above threshold", the second is "stop after SILENCE_SEC
    # below threshold". It trims the surrounding silence too, which is what we
    # want — whisper invents filler when handed leading silence.
    set -- trim 0 "$MAX_SEC"
    if [ "$SILENCE_SEC" != "0" ]; then
        set -- "$@" silence 1 0.1 "$SILENCE_THRESHOLD" 1 "$SILENCE_SEC" "$SILENCE_THRESHOLD"
        log "auto-stop armed: ${SILENCE_SEC}s below $SILENCE_THRESHOLD"
    fi

    if [ -n "$DEVICE" ]; then
        log "capturing from device: $DEVICE"
        "$SOX" -q -t coreaudio "$DEVICE" -r 16000 -c 1 -b 16 "$WAV" "$@" \
            </dev/null >>"$LOG" 2>&1 &
    else
        log "capturing from: system default input"
        "$SOX" -q -d -r 16000 -c 1 -b 16 "$WAV" "$@" \
            </dev/null >>"$LOG" 2>&1 &
    fi
    REC_PID="$!"
}

# Shared back half of `stop` and `transcribe`: gate, normalize, transcribe,
# clean. Takes a 16 kHz mono WAV. Prints the transcript, or exits via
# nothing()/die() with a reason.
transcribe_wav() {
    _src="$1"
    _label="${2:-audio}"

    # shellcheck disable=SC2046  # splitting is intended: measure() emits 3 fields
    set -- $(measure "$_src")
    _peak="$1"; _rms="$2"; _secs="$3"
    log "$_label: ${_secs}s peak=$_peak rms=$_rms"

    if "$AWK" "BEGIN{exit !(($_secs) < ($MIN_SEC))}"; then
        nothing "capture too short (${_secs}s) — hold the key until you have spoken"
    fi

    # Dead-stream guard. whisper.cpp hallucinates plausible filler on silent
    # audio ("Thank you.", "you", "Thanks for watching"), and macOS hands back
    # a stream of near-zeros when microphone access is denied, or when the
    # selected input is not actually delivering samples. Gate on RMS as well as
    # peak: a dead capture still throws transients past a peak floor, but its
    # RMS stays around 0.00005 while real speech is above 0.002.
    if "$AWK" "BEGIN{exit !(($_peak) < ($PEAK_MIN) || ($_rms) < ($RMS_MIN))}"; then
        nothing "silent capture (peak=$_peak rms=$_rms, need peak>$PEAK_MIN rms>$RMS_MIN) — check the input device and microphone permission; run: keybound-whisper doctor"
    fi

    # Peak-normalize quiet-but-real audio to about -1 dBFS so a low-gain mic
    # lands inside whisper's trained level range.
    if "$SOX" "$_src" "$NORM" norm -1 2>>"$LOG"; then _in="$NORM"; else
        log "normalize failed; using the raw capture"
        _in="$_src"
    fi

    # -nt drops timestamps. -mc 8 bounds the decoder's text context, which
    # prevents runaway repeat-loops on long captures. whisper's stderr goes to
    # the log, never to /dev/null: discarding it makes a failing model load
    # look exactly like silence.
    set -- -m "$MODEL" -f "$_in" -l "$LANG_CODE" -nt -mc 8
    [ -n "$THREADS" ] && set -- "$@" -t "$THREADS"
    # Bias decoding toward the user's own vocabulary before it ever has to be
    # corrected after the fact.
    _vprompt="$(vocab_prompt)"
    if [ -n "$_vprompt" ]; then
        set -- "$@" --prompt "$_vprompt"
        log "vocabulary: biasing with ${#_vprompt} characters of terms"
    fi
    _raw="$("$WHISPER" "$@" 2>>"$LOG")"
    _rc=$?
    rm -f "$NORM"
    [ "$_rc" -eq 0 ] || die "whisper-cli failed (exit $_rc) — see $LOG"

    # Strip whisper's non-speech annotations — [BLANK_AUDIO], [SILENCE], and
    # the *music* / *wind* asterisk forms — then flatten to a single line.
    _text="$(printf '%s' "$_raw" \
        | "$TR" -d '\r' \
        | "$SED" -E 's/\[[^]]*\]//g; s/\*[^*]*\*//g' \
        | "$TR" '\n' ' ' \
        | "$SED" -E 's/  +/ /g; s/^ +//; s/ +$//')"

    # Deterministic fix-ups for what the model still gets wrong. Applied before
    # the empty check so a rule may legitimately blank a transcript.
    _before="$_text"
    _text="$(apply_replacements "$_text")"
    [ "$_text" = "$_before" ] || log "replacements applied: [$_before] -> [$_text]"

    [ -n "$_text" ] || nothing "no speech detected (only non-speech markers) in ${_secs}s of audio"

    log "transcript: $_text"
    history_append "$_text" "$_secs" "$_peak" "$_rms" "${HISTORY_SOURCE:-unknown}"
    printf '%s\n' "$_text"
}

# ── Commands ────────────────────────────────────────────────────────────────
cmd_start() {
    require_sox
    log "──── start ────"
    # Never leave two recorders fighting over the same file.
    stop_recorder
    # Delete the previous capture BEFORE recording. Without this, a start that
    # fails to open the device leaves the last run's audio in place and `stop`
    # transcribes stale speech as though it were just spoken.
    rm -f "$WAV" "$NORM"
    printf '%s\n' "${DEVICE:-system default input}" > "$DEVFILE"

    spawn_recorder
    _pid="$REC_PID"
    printf '%s\n' "$_pid" > "$PIDFILE"

    # Confirm the recorder actually came up. sox exits immediately when the
    # device is unavailable or microphone access is blocked; reporting success
    # anyway would surface the failure only as an empty transcript later.
    _i=0
    while [ "$_i" -lt 30 ]; do
        if ! kill -0 "$_pid" 2>/dev/null; then
            rm -f "$PIDFILE"
            die "recorder exited immediately (${DEVICE:-system default input}). Recent log: $(tail -n 3 "$LOG" 2>/dev/null | "$TR" '\n' ' ')"
        fi
        [ -s "$WAV" ] && { log "recorder up (pid=$_pid)"; return 0; }
        /bin/sleep 0.05
        _i=$((_i + 1))
    done
    # Alive but nothing on disk yet: sox sometimes buffers the header. Let it run.
    log "recorder pid=$_pid alive, no bytes after 1.5s; continuing"
}

cmd_stop() {
    require_sox
    require_whisper
    log "──── stop ────"

    _was_recording=0
    [ -f "$PIDFILE" ] && _was_recording=1
    stop_recorder

    if [ "$_was_recording" -eq 0 ]; then
        # No recorder was running, so anything on disk is stale by definition.
        # Transcribing it would emit text the user never just spoke.
        rm -f "$WAV" "$NORM"
        die "stop called with no recording in progress"
    fi

    [ -s "$WAV" ] || nothing "no audio captured — the recorder produced an empty file"
    HISTORY_SOURCE="mic"
    transcribe_wav "$WAV" "capture from $(cat "$DEVFILE" 2>/dev/null)"
}

# One-shot dictation: record, wait for the recording to end, transcribe. This
# is the mode auto-stop needs, because something has to be waiting for the
# recorder to finish on its own. It ends when any of these happens:
#   - speech stops for SILENCE_SEC (when auto-stop is enabled)
#   - MAX_SEC is reached
#   - `keybound-whisper finish` signals the recorder from elsewhere
cmd_dictate() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --silence) shift; SILENCE_SEC="${1:-0}" ;;
            *) die "unknown option for dictate: $1" ;;
        esac
        shift
    done
    require_sox
    require_whisper
    log "──── dictate ────"
    stop_recorder
    rm -f "$WAV" "$NORM"
    printf '%s\n' "${DEVICE:-system default input}" > "$DEVFILE"

    spawn_recorder
    printf '%s\n' "$REC_PID" > "$PIDFILE"
    if [ "$SILENCE_SEC" = "0" ]; then
        log "dictate: auto-stop disabled; waiting for 'finish' or the ${MAX_SEC}s cap"
    fi

    # A signal-terminated recorder makes wait return non-zero, which is a
    # normal ending here, not a failure.
    rm -f "$TRANSCRIBING"
    wait "$REC_PID" 2>/dev/null
    rm -f "$PIDFILE"
    # The recorder has stopped and the model is about to run. A front end polls
    # for this file to switch its indicator, which costs it a stat() rather
    # than spawning a process every half second.
    : > "$TRANSCRIBING"

    [ -s "$WAV" ] || nothing "no audio captured — nothing was above the silence threshold ($SILENCE_THRESHOLD), or the input is not delivering audio"
    HISTORY_SOURCE="mic"
    transcribe_wav "$WAV" "dictate from $(cat "$DEVFILE" 2>/dev/null)"
    rm -f "$TRANSCRIBING"
}

# End a recording without transcribing it. The `dictate` process that owns the
# recorder notices it exit and does the transcription itself, so this is how a
# hotkey stops dictation early without racing for the same audio.
cmd_finish() {
    [ -f "$PIDFILE" ] || die "no recording in progress"
    stop_recorder
    log "finished by request"
}

cmd_toggle() {
    if recorder_alive "$(current_pid)"; then cmd_stop; else cmd_start; fi
}

cmd_transcribe() {
    [ -n "${1:-}" ] || die "usage: keybound-whisper transcribe FILE"
    [ -f "$1" ] || die "no such file: $1"
    require_sox
    require_whisper
    log "──── transcribe $1 ────"
    # Convert whatever was handed in to whisper's native format first, so any
    # sox-readable file works regardless of rate, channels or container.
    _conv="$STATE_DIR/input.wav"
    "$SOX" "$1" -r 16000 -c 1 -b 16 "$_conv" 2>>"$LOG" \
        || die "could not read audio file: $1 (see $LOG)"
    HISTORY_SOURCE="$1"
    transcribe_wav "$_conv" "file $1"
    rm -f "$_conv"
}

# Preview the replacement rules against arbitrary text. Authoring rules blind
# and discovering the mistake in a real dictation is the slow way round.
cmd_replace() {
    if [ -n "${1:-}" ]; then _t="$1"; else _t="$(cat)"; fi
    apply_replacements "$_t"
    printf '\n'
}

cmd_status() {
    printf 'keybound-whisper %s\n\n' "$KEYBOUND_VERSION"
    printf '  sox       %s\n' "${SOX:-NOT FOUND}"
    printf '  whisper   %s\n' "${WHISPER:-NOT FOUND}"
    printf '  model     %s\n' "${MODEL:-NOT FOUND}"
    printf '  input     %s\n' "${DEVICE:-system default}"
    printf '  language  %s\n' "$LANG_CODE"
    if [ "$SILENCE_SEC" = "0" ]; then
        printf '  auto-stop off (push-to-talk)\n'
    else
        printf '  auto-stop %ss below %s\n' "$SILENCE_SEC" "$SILENCE_THRESHOLD"
    fi
    printf '  vocab     %s\n' "$([ -s "$VOCAB_FILE" ] && printf '%s' "$VOCAB_FILE" || printf 'none')"
    printf '  replace   %s\n' "$([ -s "$REPLACEMENTS_FILE" ] && printf '%s' "$REPLACEMENTS_FILE" || printf 'none')"
    printf '  config    %s%s\n' "$CONFIG_FILE" "$([ -r "$CONFIG_FILE" ] && echo '' || echo '  (none)')"
    printf '  state     %s\n' "$STATE_DIR"
    printf '  log       %s\n' "$LOG"
    _pid="$(current_pid)"
    if recorder_alive "$_pid"; then
        printf '  recording YES (pid %s)\n' "$_pid"
    elif [ -f "$PIDFILE" ]; then
        printf '  recording no (stale pidfile: %s)\n' "$_pid"
    else
        printf '  recording no\n'
    fi
}

cmd_doctor() {
    _rc=0
    printf 'Dependencies\n'
    if [ -n "$SOX" ]; then printf '  ok    sox       %s\n' "$SOX"
    else printf '  FAIL  sox not found — brew install sox\n'; _rc=1; fi
    if [ -n "$WHISPER" ]; then printf '  ok    whisper   %s\n' "$WHISPER"
    else printf '  FAIL  whisper-cli not found — build whisper.cpp or set KEYBOUND_WHISPER_BIN\n'; _rc=1; fi
    if [ -n "$MODEL" ] && [ -f "$MODEL" ]; then printf '  ok    model     %s\n' "$MODEL"
    else printf '  FAIL  no model found — set KEYBOUND_MODEL\n'; _rc=1; fi

    printf '\nAudio input\n'
    if [ -n "$SWITCHAUDIO" ]; then
        printf '  system default: %s\n' "$("$SWITCHAUDIO" -c -t input 2>/dev/null)"
        printf '  available:\n'
        "$SWITCHAUDIO" -a -t input 2>/dev/null | "$SED" 's/^/    /'
    else
        printf '  (install switchaudio-osx to list devices: brew install switchaudio-osx)\n'
    fi
    printf '  configured: %s\n' "${DEVICE:-system default}"

    [ "$_rc" -eq 0 ] || { printf '\nDependencies are missing; skipping the microphone test.\n'; return 1; }

    printf '\nMicrophone test — recording 3 seconds from %s.\n' "${DEVICE:-the system default input}"
    printf 'Say something now.\n'
    _t="$STATE_DIR/doctor.wav"
    rm -f "$_t"
    if [ -n "$DEVICE" ]; then
        "$SOX" -q -t coreaudio "$DEVICE" -r 16000 -c 1 -b 16 "$_t" trim 0 3 2>&1
    else
        "$SOX" -q -d -r 16000 -c 1 -b 16 "$_t" trim 0 3 2>&1
    fi
    [ -s "$_t" ] || { printf '  FAIL  no audio was captured at all.\n'; return 1; }
    # shellcheck disable=SC2046  # splitting is intended: measure() emits 3 fields
    set -- $(measure "$_t")
    printf '  levels: peak=%s rms=%s duration=%ss\n' "$1" "$2" "$3"
    if "$AWK" "BEGIN{exit !(($1) < ($PEAK_MIN) || ($2) < ($RMS_MIN))}"; then
        printf '  FAIL  this input reads as dead (need peak>%s rms>%s).\n' "$PEAK_MIN" "$RMS_MIN"
        printf '        - Check System Settings > Privacy & Security > Microphone and\n'
        printf '          make sure the app that launches keybound-whisper is allowed.\n'
        printf '        - Check System Settings > Sound > Input and pick a working device.\n'
        printf '        - Bluetooth headsets often expose a silent input until macOS\n'
        printf '          switches them to their headset profile; try a wired or built-in mic.\n'
        _rc=1
    else
        printf '  ok    input is live\n'
    fi
    # Turn the measured peak into a silence threshold the user can paste in.
    # The threshold has to sit above room noise and below speech; halfway
    # between the two on a log scale is the safest single number.
    "$AWK" -v peak="$1" '
        BEGIN {
            pct = peak * 100
            printf "  speech peaked at %.2f%% of full scale\n", pct
            if (pct > 0.2) {
                rec = pct / 4
                if (rec < 0.3) rec = 0.3
                printf "  for auto-stop, try: KEYBOUND_SILENCE_THRESHOLD=\"%.1f%%\"\n", rec
            }
        }'

    printf '\nVocabulary and replacements\n'
    if [ -s "$VOCAB_FILE" ]; then
        printf '  %s terms in %s\n' "$("$SED" -e 's/#.*$//' "$VOCAB_FILE" | "$AWK" 'NF' | /usr/bin/wc -l | "$TR" -d ' ')" "$VOCAB_FILE"
    else
        printf '  no vocabulary file (%s)\n' "$VOCAB_FILE"
    fi
    if [ -s "$REPLACEMENTS_FILE" ]; then
        printf '  %s rules in %s\n' "$("$SED" -e 's/#.*$//' "$REPLACEMENTS_FILE" | "$AWK" '/=/' | /usr/bin/wc -l | "$TR" -d ' ')" "$REPLACEMENTS_FILE"
    else
        printf '  no replacements file (%s)\n' "$REPLACEMENTS_FILE"
    fi

    rm -f "$_t"
    return "$_rc"
}

cmd_history() {
    _sub="${1:-list}"
    shift 2>/dev/null

    case "$_sub" in
        list|"")
            history_require
            _n="${1:-20}"
            case "$_n" in ''|*[!0-9]*) die "usage: keybound-whisper history list [COUNT]" ;; esac
            # Numbered newest-first, so the index matches `history show N`.
            tail -n "$_n" "$HISTORY_FILE" | "$AWK" "$AWK_UNESCAPE"'
                { lines[NR] = $0 }
                END {
                    for (i = NR; i >= 1; i--) {
                        idx = NR - i + 1
                        ts = field(lines[i], "ts")
                        sub(/T/, " ", ts); sub(/[+-][0-9]{4}$/, "", ts)
                        t = textof(lines[i])
                        if (length(t) > 68) t = substr(t, 1, 65) "..."
                        printf "%4d  %s  %s\n", idx, ts, t
                    }
                }'
            ;;

        add)
            # Record a transcription that did not come from this tool. Useful
            # for importing history from elsewhere, and for scripting.
            if [ -n "${1:-}" ]; then _t="$1"; else _t="$(cat)"; fi
            # Flatten exactly as a real transcript is flattened, so imported
            # entries are indistinguishable in shape from recorded ones.
            _t="$(printf '%s' "$_t" | "$TR" '\n' ' ' | "$SED" -E 's/  +/ /g; s/^ +//; s/ +$//')"
            [ -n "$_t" ] || die "nothing to add"
            HISTORY_SOURCE="${2:-import}"
            history_append "$_t" "0" "0" "0" "$HISTORY_SOURCE"
            printf 'added %s characters to history\n' "$(printf '%s' "$_t" | /usr/bin/wc -c | "$TR" -d ' ')" >&2
            ;;

        show)
            history_require
            history_text_at "${1:-1}"
            ;;

        last)
            history_require
            history_text_at 1
            ;;

        copy)
            history_require
            _t="$(history_text_at "${1:-1}")" || exit 1
            printf '%s' "$_t" | /usr/bin/pbcopy
            printf 'copied %s characters to the clipboard\n' "$(printf '%s' "$_t" | /usr/bin/wc -c | "$TR" -d ' ')" >&2
            ;;

        search)
            history_require
            [ -n "${1:-}" ] || die "usage: keybound-whisper history search QUERY"
            # Case-insensitive substring match against the transcript text only,
            # so metadata fields cannot produce spurious hits.
            "$AWK" -v q="$1" "$AWK_UNESCAPE"'
                { lines[NR] = $0 }
                END {
                    n = 0
                    for (i = NR; i >= 1; i--) {
                        t = textof(lines[i])
                        if (index(tolower(t), tolower(q)) == 0) continue
                        idx = NR - i + 1
                        ts = field(lines[i], "ts")
                        sub(/T/, " ", ts); sub(/[+-][0-9]{4}$/, "", ts)
                        if (length(t) > 68) t = substr(t, 1, 65) "..."
                        printf "%4d  %s  %s\n", idx, ts, t
                        n++
                    }
                    if (n == 0) { print "no matches" > "/dev/stderr"; exit 1 }
                }' "$HISTORY_FILE"
            ;;

        stats)
            history_require
            "$AWK" "$AWK_UNESCAPE"'
                { n++; c += length(textof($0)); s += field($0, "seconds") + 0
                  if (n == 1) first = field($0, "ts") }
                END {
                    sub(/T/, " ", first); sub(/[+-][0-9]{4}$/, "", first)
                    printf "  entries    %d\n", n
                    printf "  since      %s\n", first
                    printf "  characters %d\n", c
                    printf "  audio      %.1f minutes\n", s / 60
                    if (n > 0) printf "  average    %d characters per dictation\n", c / n
                }' "$HISTORY_FILE"
            ;;

        export)
            history_require
            cat "$HISTORY_FILE"
            ;;

        path)
            printf '%s\n' "$HISTORY_FILE"
            ;;

        clear)
            [ -s "$HISTORY_FILE" ] || die "no history to clear"
            _count="$(/usr/bin/wc -l < "$HISTORY_FILE" | "$TR" -d ' ')"
            # Destructive and unrecoverable, so require an explicit --yes rather
            # than prompting: this is often run from a hotkey with no terminal.
            if [ "${1:-}" != "--yes" ]; then
                die "this deletes $_count stored transcriptions permanently. Re-run: keybound-whisper history clear --yes"
            fi
            rm -f "$HISTORY_FILE"
            printf 'deleted %s stored transcriptions\n' "$_count" >&2
            ;;

        *)
            die "unknown history command: $_sub (try: list, show, last, copy, search, add, stats, export, path, clear)"
            ;;
    esac
}

usage() {
    cat <<'USAGE'
keybound-whisper — offline push-to-talk dictation for macOS

  keybound-whisper start               begin recording
  keybound-whisper stop                finish recording, print the transcript
  keybound-whisper toggle              start if idle, stop if recording
  keybound-whisper dictate [--silence N]
                                    record until you stop speaking, then print
  keybound-whisper finish              end a recording without transcribing it
  keybound-whisper transcribe FILE     transcribe an existing audio file

  keybound-whisper history [list [N]]  recent transcriptions, newest first
  keybound-whisper history show N      print entry N in full (1 = most recent)
  keybound-whisper history last        print the most recent transcription
  keybound-whisper history copy [N]    copy entry N to the clipboard
  keybound-whisper history search Q    find past transcriptions containing Q
  keybound-whisper history add TEXT    record a transcription from elsewhere
  keybound-whisper replace TEXT        preview your replacement rules on TEXT
  keybound-whisper history stats       how much has been dictated
  keybound-whisper history export      raw JSONL on stdout
  keybound-whisper history path        where history is stored
  keybound-whisper history clear --yes delete all stored transcriptions

  keybound-whisper status              current state and resolved configuration
  keybound-whisper doctor              check dependencies and test the microphone
  keybound-whisper version             print the version

Audio is captured from the system default input and transcribed locally.
Nothing leaves the machine.
USAGE
}

case "${1:-}" in
    start)       cmd_start ;;
    stop)        cmd_stop ;;
    toggle)      cmd_toggle ;;
    dictate)     shift; cmd_dictate "$@" ;;
    finish)      cmd_finish ;;
    transcribe)  shift; cmd_transcribe "${1:-}" ;;
    history)     shift; cmd_history "$@" ;;
    replace)     shift; cmd_replace "${1:-}" ;;
    status)      cmd_status ;;
    doctor)      cmd_doctor ;;
    version|--version|-v) printf 'keybound-whisper %s\n' "$KEYBOUND_VERSION" ;;
    help|--help|-h) usage ;;
    *)           usage >&2; exit 2 ;;
esac
