#!/usr/bin/env bash
#
# keybind-whisper — local, offline push-to-talk dictation for macOS.
#
# Records from the system default input, transcribes with whisper.cpp, and
# prints the text to stdout. Nothing leaves the machine.
#
#   keybind-whisper start            begin recording (backgrounded)
#   keybind-whisper stop             finish recording, print the transcript
#   keybind-whisper toggle           start if idle, stop if recording
#   keybind-whisper transcribe FILE  transcribe an existing audio file
#   keybind-whisper status           report current state and resolved config
#   keybind-whisper doctor           check dependencies and test the microphone
#   keybind-whisper version          print the version
#
# ── Output contract ─────────────────────────────────────────────────────────
# Callers depend on this; do not weaken it.
#
#   exit 0, stdout non-empty : the transcript
#   exit 0, stdout empty     : nothing usable was heard; stderr says why
#   exit non-zero            : a real failure; stderr carries the message
#
# stdout is ONLY ever the transcript, so a caller can paste it blind. Every
# diagnostic goes to stderr and to the log.
#
# ── Never rely on PATH ──────────────────────────────────────────────────────
# This is designed to be driven by a GUI hotkey daemon. Processes spawned by
# macOS LaunchServices inherit PATH=/usr/bin:/bin:/usr/sbin:/sbin, which does
# not include Homebrew. A bare `sox` resolves fine in a login shell and fails
# with 127 under a GUI app — producing an empty transcript on every run, with
# the error swallowed. Every external binary here is resolved explicitly.
#
# Targets bash 3.2, the version macOS ships. No bash 4+ syntax.

# Deliberately not `set -e`: this tool's job is to always explain itself, so
# errors are handled explicitly rather than exiting silently mid-pipeline.
set -uo pipefail

KEYBIND_VERSION="1.2.0"

# ── Configuration ───────────────────────────────────────────────────────────
# Every setting is an environment variable with a safe default. An optional
# config file can set any of them; the environment still wins.
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_FILE="${KEYBIND_CONFIG:-$CONFIG_HOME/keybind-whisper/config}"
# shellcheck source=/dev/null
[ -r "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# Input device. EMPTY IS THE DEFAULT AND THE RECOMMENDED SETTING: it records
# from whatever macOS has set as the system default input, so the tool follows
# the OS the way every other app does. Set it only to pin one specific device.
DEVICE="${KEYBIND_DEVICE:-}"

# ── Backend ─────────────────────────────────────────────────────────────────
# Where transcription actually happens.
#
#   cli     spawn whisper-cli per utterance. The default: nothing to run, works
#           offline, and the audio never leaves the process tree. It also
#           re-reads the whole model from disk every single time — about 1.6 s
#           of a 2.9 s dictation on an M1 Pro with large-v3-turbo.
#   server  POST to a local whisper-server that holds the model resident.
#           Same machine, same weights, same privacy; roughly 3.7x faster
#           because the load happens once at startup instead of per utterance.
#   api     POST to an OpenAI-compatible transcription endpoint. THIS SENDS
#           YOUR AUDIO OFF THE MACHINE unless the URL is a local one. It is
#           never selected automatically and never used as a fallback.
BACKEND="${KEYBIND_BACKEND:-cli}"
SERVER_URL="${KEYBIND_SERVER_URL:-http://127.0.0.1:8080}"
API_URL="${KEYBIND_API_URL:-https://api.openai.com/v1/audio/transcriptions}"
API_KEY="${KEYBIND_API_KEY:-}"
API_MODEL="${KEYBIND_API_MODEL:-whisper-1}"
HTTP_TIMEOUT="${KEYBIND_HTTP_TIMEOUT:-120}"
# A local server that is not running falls back to the local CLI, because both
# are on this machine and a dictation you already spoke should not be lost to a
# daemon that died. Never set this for the api backend: falling back there
# would silently change where your audio goes.
SERVER_FALLBACK="${KEYBIND_SERVER_FALLBACK:-1}"

LANG_CODE="${KEYBIND_LANG:-en}"
THREADS="${KEYBIND_THREADS:-}"

# Dead-stream thresholds. Raise if your mic is hot, lower if it is very quiet.
PEAK_MIN="${KEYBIND_PEAK_MIN:-0.0008}"
RMS_MIN="${KEYBIND_RMS_MIN:-0.0006}"
# Shortest capture worth transcribing; below this it is a fumbled keypress.
MIN_SEC="${KEYBIND_MIN_SEC:-0.30}"
# Hard cap so a forgotten recording cannot run until the disk fills. sox closes
# the file cleanly and exits on its own when it reaches this.
MAX_SEC="${KEYBIND_MAX_SEC:-1800}"

# ── History ─────────────────────────────────────────────────────────────────
# Every successful transcription is appended to a JSONL file so past dictation
# can be found and reused. This is dictated text: treat it as sensitive. The
# file is created 0600 inside a 0700 directory, and history can be turned off
# entirely by setting KEYBIND_HISTORY=0.
HISTORY_ENABLED="${KEYBIND_HISTORY:-1}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
HISTORY_FILE="${KEYBIND_HISTORY_FILE:-$DATA_HOME/keybind-whisper/history.jsonl}"
# Entries kept. Older ones are dropped as new ones arrive.
HISTORY_MAX="${KEYBIND_HISTORY_MAX:-1000}"

# ── Auto-stop on silence ────────────────────────────────────────────────────
# Seconds of silence that end a recording. 0 disables it, which is the default:
# the tool is push-to-talk, so recording normally ends when you say it does.
# When enabled, `dictate` records until you stop speaking.
SILENCE_SEC="${KEYBIND_SILENCE_SEC:-0}"
# Amplitude below which audio counts as silence, as a percentage of full scale.
# Must sit above your room noise and below your speech. `doctor` measures both
# and prints a recommendation.
SILENCE_THRESHOLD="${KEYBIND_SILENCE_THRESHOLD:-2%}"

# ── Vocabulary and replacements ─────────────────────────────────────────────
# Two separate mechanisms, because they fix different failures.
#
# vocabulary   terms fed to the model as an initial prompt, which biases
#              decoding toward them. Catches proper nouns before they are
#              mistranscribed, but is a nudge, not a guarantee.
# replacements literal find-and-replace applied after transcription. Catches
#              what the model gets wrong anyway, deterministically.
VOCAB_FILE="${KEYBIND_VOCAB_FILE:-$CONFIG_HOME/keybind-whisper/vocabulary}"
REPLACEMENTS_FILE="${KEYBIND_REPLACEMENTS_FILE:-$CONFIG_HOME/keybind-whisper/replacements}"

# Per-user state directory. Not $TMPDIR: macOS gives each process context a
# different private $TMPDIR, so `start` and `stop` would not agree on a path.
STATE_DIR="${KEYBIND_STATE_DIR:-/tmp/keybind-whisper-$(id -u)}"
mkdir -p "$STATE_DIR" 2>/dev/null
# Captured audio and transcripts pass through here, and the default lives under
# the world-writable /tmp, where another user could pre-create the directory or
# plant a symlink at that path and read everything. Refuse anything that is not
# a real directory we own.
if [ -L "$STATE_DIR" ]; then
    printf 'refusing to use %s: it is a symlink\n' "$STATE_DIR" >&2
    exit 1
fi
if [ ! -d "$STATE_DIR" ]; then
    printf 'cannot create the state directory %s\n' "$STATE_DIR" >&2
    exit 1
fi
if [ "$(/usr/bin/stat -f %u "$STATE_DIR" 2>/dev/null)" != "$(id -u)" ]; then
    printf 'refusing to use %s: it is owned by another user\n' "$STATE_DIR" >&2
    exit 1
fi
chmod 700 "$STATE_DIR" 2>/dev/null

WAV="$STATE_DIR/capture.wav"
NORM="$STATE_DIR/capture.norm.wav"
PIDFILE="$STATE_DIR/recorder.pid"
DEVFILE="$STATE_DIR/device"
TRANSCRIBING="$STATE_DIR/transcribing"
LOG="${KEYBIND_LOG:-$STATE_DIR/keybind-whisper.log}"

# Core utilities, pinned. All are in the restricted GUI PATH.
DATE="/bin/date"; AWK="/usr/bin/awk"; SED="/usr/bin/sed"; TR="/usr/bin/tr"; PS="/bin/ps"

# ── Output helpers ──────────────────────────────────────────────────────────
log() {
    # Keep the log from growing without bound across months of daily use.
    if [ -f "$LOG" ]; then
        sz=$(/usr/bin/stat -f%z "$LOG" 2>/dev/null || echo 0)
        [ "$sz" -gt 1048576 ] && mv -f "$LOG" "$LOG.1" 2>/dev/null
    fi
    printf '%s %s\n' "$("$DATE" '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG" 2>/dev/null
}

# Fatal: message on stderr and in the log, nothing on stdout, non-zero exit.
die() { log "ERROR: $*"; printf '%s\n' "$*" >&2; exit 1; }

# "Nothing usable": empty stdout, reason on stderr, exit 0.
nothing() { log "EMPTY: $*"; printf '%s\n' "$*" >&2; exit 0; }

# ── Dependency resolution (never trusts PATH) ───────────────────────────────
resolve_bin() {
    _name="$1"; shift
    for _c in "$@"; do
        [ -n "$_c" ] && [ -x "$_c" ] && { printf '%s\n' "$_c"; return 0; }
    done
    _c="$(command -v "$_name" 2>/dev/null)"
    [ -n "$_c" ] && [ -x "$_c" ] && { printf '%s\n' "$_c"; return 0; }
    return 1
}

SOX="${KEYBIND_SOX:-$(resolve_bin sox \
    /opt/homebrew/bin/sox /usr/local/bin/sox)}"

# whisper.cpp's CLI is `whisper-cli`; older builds called it `main`.
WHISPER="${KEYBIND_WHISPER_BIN:-$(resolve_bin whisper-cli \
    /opt/homebrew/bin/whisper-cli /usr/local/bin/whisper-cli \
    "$HOME/code/whisper.cpp/build/bin/whisper-cli" \
    "$HOME/whisper.cpp/build/bin/whisper-cli" \
    "$HOME/src/whisper.cpp/build/bin/whisper-cli")}"

# Optional: only used to name and list audio devices in `doctor`.
SWITCHAUDIO="${KEYBIND_SWITCHAUDIO:-$(resolve_bin SwitchAudioSource \
    /opt/homebrew/bin/SwitchAudioSource /usr/local/bin/SwitchAudioSource)}"

# Shared model store. One directory per model, so weights live in one place on
# the machine and every tool points at the same file instead of each keeping a
# multi-gigabyte copy.
MODELS_DIR="${KEYBIND_MODELS_DIR:-$HOME/.cauldron/.models}"

# Is this file plausibly the model its name claims to be? Both checks are
# needed and neither is sufficient alone: a truncated download keeps the ggml
# magic of its first bytes, and a file of the right size could be anything.
# Discovered on a real machine, where a 57 MB ggml-medium.bin sat next to a
# good model and would have been preferred over every smaller one, then failed
# at transcription time with nothing but an exit code to explain it.
model_min_mb() {
    case "$1" in
        # A quantized model is a fraction of its family's full size and the
        # ratio varies by scheme, so the family floor would reject a perfectly
        # good file. Fall back to a generic sanity floor instead.
        *-q[2-8]_[01]*|*-q[2-8]k*|*-q[2-8]K*) echo 20 ;;
        *turbo*)  echo 700  ;;   # large-v3-turbo is ~1.5 GB, not ~3 GB
        *large*)  echo 2500 ;;
        *medium*) echo 1300 ;;
        *small*)  echo 400  ;;
        *base*)   echo 120  ;;
        *tiny*)   echo 60   ;;
        *)        echo 20   ;;   # unknown naming: only a sanity floor
    esac
}

# Preference order, lowest first. Ranking by FILE rather than by searching for
# exact filenames lets the store use any directory layout and still pick the
# best model present, including quantized variants.
model_rank() {
    case "$(basename "$1")" in
        ggml-large-v3-turbo*) echo 1  ;;
        ggml-large-v3*)       echo 2  ;;
        ggml-large-v2*)       echo 3  ;;
        ggml-large*)          echo 4  ;;
        ggml-medium.en*)      echo 5  ;;
        ggml-medium*)         echo 6  ;;
        ggml-small.en*)       echo 7  ;;
        ggml-small*)          echo 8  ;;
        ggml-base.en*)        echo 9  ;;
        ggml-base*)           echo 10 ;;
        ggml-tiny.en*)        echo 11 ;;
        ggml-tiny*)           echo 12 ;;
        *)                    echo 50 ;;
    esac
}

model_problem() {
    _m="$1"
    [ -f "$_m" ] || { printf 'not found'; return 0; }
    _magic="$(head -c 4 "$_m" 2>/dev/null | /usr/bin/xxd -p 2>/dev/null)"
    [ "$_magic" = "6c6d6767" ] || { printf 'not a ggml model file (magic %s)' "${_magic:-none}"; return 0; }
    _mb=$(( $(/usr/bin/stat -f%z "$_m" 2>/dev/null || echo 0) / 1048576 ))
    _min="$(model_min_mb "$(basename "$_m")")"
    if [ "$_min" -gt 0 ] && [ "$_mb" -lt "$_min" ]; then
        printf 'truncated: %s MB, expected at least %s MB for this model' "$_mb" "$_min"
        return 0
    fi
    return 1
}

# Model discovery: an explicit setting wins, otherwise search the usual places
# in descending order of quality so a fresh install just works.
# Every place a model may live, in the order they are searched. The shared
# store comes first: it is the system-wide location, so a model placed there is
# the one meant to be used, and nothing has to be copied per project.
model_search_globs() {
    # Slug directories first — one model per directory, any naming — then a
    # flat drop at the store root, then the historical per-project locations.
    printf '%s\n' \
        "$MODELS_DIR"/*/ggml-*.bin \
        "$MODELS_DIR"/ggml-*.bin \
        "${XDG_DATA_HOME:-$HOME/.local/share}/keybind-whisper/models"/ggml-*.bin \
        "$HOME/.local/share/keybind-whisper/models"/ggml-*.bin \
        "$HOME/code/whisper.cpp/models"/ggml-*.bin \
        "$HOME/whisper.cpp/models"/ggml-*.bin \
        "$HOME/src/whisper.cpp/models"/ggml-*.bin \
        /opt/homebrew/share/whisper-cpp/models/ggml-*.bin \
        /usr/local/share/whisper-cpp/models/ggml-*.bin
}

# Pick the best usable model found anywhere.
#
# Ranked by MODEL QUALITY first and directory order only as a tiebreak: a
# better model in a legacy directory should still beat a worse one in the
# shared store, because which weights get used affects the transcript and
# where they sit does not.
find_model() {
    if [ -n "${KEYBIND_MODEL:-}" ]; then printf '%s\n' "$KEYBIND_MODEL"; return 0; fi
    _best=""; _best_rank=9999
    while IFS= read -r _f; do
        [ -f "$_f" ] || continue          # unmatched globs stay literal
        if _why="$(model_problem "$_f")"; then
            log "ignoring $_f: $_why"
            continue
        fi
        _r="$(model_rank "$_f")"
        if [ "$_r" -lt "$_best_rank" ]; then _best_rank="$_r"; _best="$_f"; fi
    done <<EOF
$(model_search_globs)
EOF
    [ -n "$_best" ] || return 1
    printf '%s\n' "$_best"
}
MODEL="$(find_model)"

require_sox() {
    [ -n "$SOX" ] || die "sox not found. Install it: brew install sox"
}
require_whisper() {
    [ -n "$WHISPER" ] || die "whisper-cli not found. Install whisper.cpp, or set KEYBIND_WHISPER_BIN."
    [ -n "$MODEL" ] && [ -f "$MODEL" ] || die "no whisper model found. Download one and set KEYBIND_MODEL."
}

# ── Recorder process management ─────────────────────────────────────────────
# True only when $1 is a live pid that looks like one of our recorders, so a
# recycled pid is not signalled by mistake. The name match is a sanity check
# rather than a security boundary: the pid came from a file in a 0700 directory
# we own, which is what actually makes it trustworthy.
recorder_alive() {
    _pid="${1:-}"
    [ -n "$_pid" ] || return 1
    case "$_pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$_pid" 2>/dev/null || return 1
    case "$("$PS" -o command= -p "$_pid" 2>/dev/null)" in *sox*) return 0 ;; *) return 1 ;; esac
}

current_pid() { cat "$PIDFILE" 2>/dev/null; }

# SIGINT first so sox writes a valid WAV trailer; escalate only if it refuses.
stop_recorder() {
    [ -f "$PIDFILE" ] || return 0
    _pid="$(current_pid)"
    if recorder_alive "$_pid"; then
        log "stopping recorder pid=$_pid"
        kill -INT "$_pid" 2>/dev/null
        _i=0
        while [ "$_i" -lt 100 ]; do
            recorder_alive "$_pid" || break
            /bin/sleep 0.05
            _i=$((_i + 1))
        done
        if recorder_alive "$_pid"; then
            log "pid=$_pid ignored SIGINT after 5s; sending TERM"
            kill -TERM "$_pid" 2>/dev/null
            /bin/sleep 0.5
            recorder_alive "$_pid" && { log "escalating to KILL"; kill -KILL "$_pid" 2>/dev/null; }
        fi
    else
        log "pidfile named pid=$_pid, which is not a live recorder; ignoring"
    fi
    rm -f "$PIDFILE"
}

# ── Audio helpers ───────────────────────────────────────────────────────────
# Print "<peak> <rms> <seconds>" for an audio file.
measure() {
    _s="$("$SOX" "$1" -n stat 2>&1)"
    _p="$(printf '%s\n' "$_s" | "$AWK" '/Maximum amplitude/{print $3; exit}')"
    _r="$(printf '%s\n' "$_s" | "$AWK" '/RMS +amplitude/{print $3; exit}')"
    _l="$(printf '%s\n' "$_s" | "$AWK" '/Length \(seconds\)/{print $3; exit}')"
    printf '%s %s %s\n' "${_p:-0}" "${_r:-0}" "${_l:-0}"
}

# ── History store ───────────────────────────────────────────────────────────
# Format is JSONL: one self-contained JSON object per line, newest last. It is
# append-only, greppable with ordinary tools, and trivial to export. Field
# order is fixed and `text` is always last, which is what lets the readers
# below extract it without a JSON parser.

# Escape a string for embedding in a JSON string literal. The text has already
# been flattened to a single line, so stripping control characters outright is
# safe and leaves only backslash and double quote to escape.
json_escape() {
    printf '%s' "$1" | "$TR" -d '\000-\037' | "$SED" -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Shared awk helper: reverse a JSON string escape. Done in awk rather than with
# sed placeholders so that backslashes in dictated text round-trip correctly.
AWK_UNESCAPE='
function unesc(s,   out, i, c, d) {
    out = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\\" && i < length(s)) {
            i++; d = substr(s, i, 1)
            out = out (d == "n" ? "\n" : (d == "t" ? "\t" : d))
        } else out = out c
    }
    return out
}
function field(line, key,   m) {
    m = line
    if (!sub("^.*\"" key "\":\"", "", m)) return ""
    sub("\".*$", "", m)
    return m
}
function textof(line,   m) {
    m = line
    if (!sub(/^.*"text":"/, "", m)) return ""
    sub(/"}[ \t]*$/, "", m)
    return unesc(m)
}
'

history_append() {
    [ "$HISTORY_ENABLED" = "1" ] || return 0
    _htext="$1"; _hsecs="$2"; _hpeak="$3"; _hrms="$4"; _hsrc="$5"

    _hdir="$(dirname "$HISTORY_FILE")"
    mkdir -p "$_hdir" 2>/dev/null || { log "history: cannot create $_hdir"; return 0; }
    chmod 700 "$_hdir" 2>/dev/null
    if [ ! -e "$HISTORY_FILE" ]; then
        : > "$HISTORY_FILE" 2>/dev/null || { log "history: cannot write $HISTORY_FILE"; return 0; }
    fi
    chmod 600 "$HISTORY_FILE" 2>/dev/null

    printf '{"ts":"%s","epoch":%s,"seconds":"%s","peak":"%s","rms":"%s","source":"%s","chars":%s,"text":"%s"}\n' \
        "$("$DATE" '+%Y-%m-%dT%H:%M:%S%z')" \
        "$("$DATE" '+%s')" \
        "$(json_escape "$_hsecs")" \
        "$(json_escape "$_hpeak")" \
        "$(json_escape "$_hrms")" \
        "$(json_escape "$_hsrc")" \
        "$(printf '%s' "$_htext" | /usr/bin/wc -c | "$TR" -d ' ')" \
        "$(json_escape "$_htext")" \
        >> "$HISTORY_FILE" 2>/dev/null || log "history: append failed"

    # Trim in batches rather than on every write, so a long history does not
    # mean rewriting the whole file after every sentence.
    _hcount="$(/usr/bin/wc -l < "$HISTORY_FILE" 2>/dev/null | "$TR" -d ' ')"
    if [ -n "$_hcount" ] && [ "$_hcount" -gt $((HISTORY_MAX + 100)) ]; then
        if tail -n "$HISTORY_MAX" "$HISTORY_FILE" > "$HISTORY_FILE.tmp" 2>/dev/null; then
            chmod 600 "$HISTORY_FILE.tmp" 2>/dev/null
            mv -f "$HISTORY_FILE.tmp" "$HISTORY_FILE"
            log "history: trimmed to $HISTORY_MAX entries"
        else
            rm -f "$HISTORY_FILE.tmp"
        fi
    fi
}

history_require() {
    [ -s "$HISTORY_FILE" ] || die "no history yet ($HISTORY_FILE)"
}

# Entry 1 is the most recent, counting backwards, which is how someone asks for
# "the last one" or "three back".
history_line_at() {
    _n="${1:-1}"
    case "$_n" in ''|*[!0-9]*) die "history index must be a number: $_n" ;; esac
    [ "$_n" -ge 1 ] || die "history index starts at 1"
    _total="$(/usr/bin/wc -l < "$HISTORY_FILE" | "$TR" -d ' ')"
    [ "$_n" -le "$_total" ] || die "no history entry $_n (only $_total stored)"
    tail -n "$_n" "$HISTORY_FILE" | head -n 1
}

# ── Vocabulary biasing ──────────────────────────────────────────────────────
# Join the vocabulary into one comma-separated initial prompt. whisper caps the
# prompt at n_text_ctx/2 tokens, so an oversized list is truncated rather than
# silently rejected by the model.
VOCAB_PROMPT_MAX="${KEYBIND_VOCAB_PROMPT_MAX:-800}"
vocab_prompt() {
    [ -f "$VOCAB_FILE" ] || return 0
    _vp="$("$SED" -e 's/#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$VOCAB_FILE" \
        | "$AWK" 'NF { terms = terms (terms ? ", " : "") $0 } END { print terms }')"
    [ -n "$_vp" ] || return 0
    if [ "${#_vp}" -gt "$VOCAB_PROMPT_MAX" ]; then
        _vp="$(printf '%s' "$_vp" | cut -c "1-$VOCAB_PROMPT_MAX")"
        log "vocabulary: truncated the prompt to $VOCAB_PROMPT_MAX characters"
    fi
    # Framed as a sentence rather than passed as a bare comma list. whisper
    # imitates the prompt's style, so an unpunctuated fragment can cost you
    # capitalization and punctuation in the transcript; a well-formed sentence
    # biases the vocabulary without dragging the style along with it.
    printf 'The following terms may appear: %s.' "$_vp"
}

# ── Replacements ────────────────────────────────────────────────────────────
# Rules are `find = replace`, one per line, # for comments. Matching is literal
# and case-insensitive, and only fires on whole words, so a rule for "arm" can
# never rewrite the middle of "alarm". Literal rather than regex matching keeps
# the file safe to edit without knowing regex syntax; regex support is tracked
# in ROADMAP.md.
apply_replacements() {
    _rtext="$1"
    [ -s "$REPLACEMENTS_FILE" ] || { printf '%s' "$_rtext"; return 0; }
    printf '%s' "$_rtext" | "$AWK" -v rulefile="$REPLACEMENTS_FILE" '
        function is_word(c) { return c ~ /[A-Za-z0-9]/ }

        # Single left-to-right pass. At each position the rules are tried in
        # file order and the first whole-word match wins; the replacement is
        # emitted and the cursor jumps past the matched SOURCE text, so a
        # replacement is never re-examined. That matters: applying rules one
        # after another over the whole string instead would let them cascade,
        # so "cat = dog" followed by "dog = ferret" would yield "ferret" and
        # adding a rule could silently break an existing one.
        #
        # Matching uses substr() against a lowercased copy rather than a regex,
        # which makes it literal and case-insensitive: punctuation and regex
        # metacharacters in a rule mean exactly the characters they are.
        function apply_rules(text,   lt, out, pos, L, j, flen, before, after, ap, hit) {
            lt = tolower(text); L = length(text); out = ""; pos = 1
            while (pos <= L) {
                hit = 0
                for (j = 1; j <= n; j++) {
                    flen = flens[j]
                    if (flen == 0 || substr(lt, pos, flen) != lfinds[j]) continue
                    before = (pos == 1) ? "" : substr(text, pos - 1, 1)
                    ap = pos + flen
                    after = (ap > L) ? "" : substr(text, ap, 1)
                    if ((before == "" || !is_word(before)) && (after == "" || !is_word(after))) {
                        out = out repls[j]; pos += flen; hit = 1
                        break
                    }
                }
                if (!hit) { out = out substr(text, pos, 1); pos++ }
            }
            return out
        }

        BEGIN {
            n = 0
            while ((getline line < rulefile) > 0) {
                sub(/#.*$/, "", line)
                if (line !~ /=/) continue
                eq = index(line, "=")
                f = substr(line, 1, eq - 1)
                r = substr(line, eq + 1)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", f)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", r)
                if (f == "") continue
                n++; lfinds[n] = tolower(f); flens[n] = length(f); repls[n] = r
            }
            close(rulefile)
        }

        {
            out = apply_rules($0)
            # A rule whose replacement is empty leaves a gap behind, so
            # re-flatten whitespace the same way the raw transcript was.
            gsub(/[ \t]+/, " ", out)
            gsub(/^ +| +$/, "", out)
            printf "%s", out
        }
    '
}

history_text_at() {
    # die() inside a command substitution only exits the subshell, so the
    # failure has to be propagated explicitly or an invalid index would print
    # an error and still exit 0.
    _line="$(history_line_at "$1")" || exit 1
    printf '%s\n' "$_line" | "$AWK" "$AWK_UNESCAPE"'{print textof($0)}'
}

# Start sox in the background writing 16 kHz mono 16-bit — whisper's native
# format, so no resampling happens later. An empty $DEVICE means `-d`, the
# system default input.
# Sets REC_PID rather than printing it: a command substitution would put the
# background job inside a subshell, and `wait` in cmd_dictate could not reach it.
REC_PID=""
spawn_recorder() {
    # Effect chain. `trim 0 MAX_SEC` is the runaway guard. When auto-stop is on,
    # `silence` also ends the recording once speech stops: the first triple is
    # "begin after 0.1s above threshold", the second is "stop after SILENCE_SEC
    # below threshold". It trims the surrounding silence too, which is what we
    # want — whisper invents filler when handed leading silence.
    set -- trim 0 "$MAX_SEC"
    if [ "$SILENCE_SEC" != "0" ]; then
        set -- "$@" silence 1 0.1 "$SILENCE_THRESHOLD" 1 "$SILENCE_SEC" "$SILENCE_THRESHOLD"
        log "auto-stop armed: ${SILENCE_SEC}s below $SILENCE_THRESHOLD"
    fi

    if [ -n "$DEVICE" ]; then
        log "capturing from device: $DEVICE"
        "$SOX" -q -t coreaudio "$DEVICE" -r 16000 -c 1 -b 16 "$WAV" "$@" \
            </dev/null >>"$LOG" 2>&1 &
    else
        log "capturing from: system default input"
        "$SOX" -q -d -r 16000 -c 1 -b 16 "$WAV" "$@" \
            </dev/null >>"$LOG" 2>&1 &
    fi
    REC_PID="$!"
}

# Shared back half of `stop` and `transcribe`: gate, normalize, transcribe,
# clean. Takes a 16 kHz mono WAV. Prints the transcript, or exits via
# nothing()/die() with a reason.
# ── Backends ────────────────────────────────────────────────────────────────
# Each takes a 16 kHz mono WAV and an optional vocabulary prompt, prints the
# raw transcript on stdout, and returns non-zero with a reason on stderr.

CURL="/usr/bin/curl"

is_loopback_url() {
    case "$1" in
        http://127.0.0.1*|http://localhost*|http://[::1]*|https://127.0.0.1*|https://localhost*) return 0 ;;
        *) return 1 ;;
    esac
}

# Redact anything secret before it reaches the log. The key is also kept off
# the command line entirely (see backend_api), because arguments are visible
# in `ps` to every process running as this user.
scrub() {
    # Fixed-string redaction, not a regex. Building a pattern out of the key
    # means escaping it, and an escape that is wrong anywhere makes the
    # expression invalid — at which point the redactor FAILS OPEN and writes
    # the secret it was supposed to hide. A key containing / broke exactly
    # that way. index() and substr() need no escaping and cannot misparse.
    #
    # The key arrives through the environment rather than -v, because awk
    # interprets backslash escapes in a -v value and a key may contain one.
    if [ -n "$API_KEY" ]; then
        _SCRUB_KEY="$API_KEY" "$AWK" '
            BEGIN { k = ENVIRON["_SCRUB_KEY"] }
            {
                if (length(k) > 0) {
                    while ((p = index($0, k)) > 0)
                        $0 = substr($0, 1, p - 1) "<redacted>" substr($0, p + length(k))
                }
                # Belt and braces: redact anything bearer-shaped even if it is
                # not the key we know about.
                gsub(/Bearer [^" ]+/, "Bearer <redacted>")
                print
            }'
    else
        "$AWK" '{ gsub(/Bearer [^" ]+/, "Bearer <redacted>"); print }'
    fi
}

# Turn an HTTP status into something a person can act on.
http_explain() {
    case "$1" in
        000) printf 'could not connect (is it running, and is the URL right?)' ;;
        400) printf 'the endpoint rejected the request (400)' ;;
        401|403) printf 'authentication failed (%s) — check KEYBIND_API_KEY' "$1" ;;
        404) printf 'no transcription endpoint at that URL (404)' ;;
        413) printf 'the audio was too large for the endpoint (413)' ;;
        429) printf 'rate limited (429) — try again shortly' ;;
        5*)  printf 'the endpoint failed (%s)' "$1" ;;
        *)   printf 'unexpected HTTP status %s' "$1" ;;
    esac
}

backend_cli() {
    _bwav="$1"; _bprompt="$2"
    require_whisper
    # -nt drops timestamps. -mc 8 bounds the decoder's text context, which
    # prevents runaway repeat-loops on long captures. whisper's stderr goes to
    # the log, never to /dev/null: discarding it makes a failing model load
    # look exactly like silence.
    set -- -m "$MODEL" -f "$_bwav" -l "$LANG_CODE" -nt -mc 8
    [ -n "$THREADS" ] && set -- "$@" -t "$THREADS"
    [ -n "$_bprompt" ] && set -- "$@" --prompt "$_bprompt"

    _out="$("$WHISPER" "$@" 2>>"$LOG")"
    _rc=$?
    if [ "$_rc" -ne 0 ]; then
        # A truncated or corrupt model is the common cause and says so plainly
        # in whisper's own output; without this it surfaces as a bare exit code.
        if tail -n 40 "$LOG" 2>/dev/null | grep -q "not all tensors loaded\|failed to load model"; then
            printf 'the model file looks corrupt or truncated: %s\n' "$MODEL" >&2
        else
            printf 'whisper-cli failed (exit %s) — see %s\n' "$_rc" "$LOG" >&2
        fi
        return 1
    fi
    printf '%s' "$_out"
}

# whisper.cpp's own server. Its route is /inference; it does NOT serve the
# OpenAI path, so the two remote backends are deliberately separate rather
# than one parameterised call.
backend_server() {
    _bwav="$1"; _bprompt="$2"
    _url="${SERVER_URL%/}/inference"
    _body="$STATE_DIR/http.$$.out"
    log "server backend: POST $_url"
    _code="$("$CURL" -sS --max-time "$HTTP_TIMEOUT" -o "$_body" -w '%{http_code}' \
        -X POST "$_url" \
        -F "file=@$_bwav" \
        -F "response_format=text" \
        -F "temperature=0" \
        ${_bprompt:+-F "prompt=$_bprompt"} 2>>"$LOG")"
    if [ "$_code" != "200" ]; then
        printf 'whisper-server at %s: %s\n' "$SERVER_URL" "$(http_explain "$_code")" >&2
        [ -s "$_body" ] && log "server body: $(head -c 400 "$_body")"
        rm -f "$_body"
        return 1
    fi
    cat "$_body"
    rm -f "$_body"
}

# Any OpenAI-shaped /v1/audio/transcriptions endpoint: OpenAI itself, or a
# local or self-hosted service that implements the same route.
backend_api() {
    _bwav="$1"; _bprompt="$2"
    _body="$STATE_DIR/http.$$.out"
    # The key goes in a curl config file, never in argv: command lines are
    # readable by any process of this user via `ps`.
    _cfg="$STATE_DIR/http.$$.cfg"
    : > "$_cfg"; chmod 600 "$_cfg"
    [ -n "$API_KEY" ] && printf 'header = "Authorization: Bearer %s"\n' "$API_KEY" >> "$_cfg"

    log "api backend: POST $API_URL (model $API_MODEL)"
    _code="$("$CURL" -sS --max-time "$HTTP_TIMEOUT" --config "$_cfg" -o "$_body" -w '%{http_code}' \
        -X POST "$API_URL" \
        -F "file=@$_bwav" \
        -F "model=$API_MODEL" \
        -F "response_format=text" \
        ${LANG_CODE:+-F "language=$LANG_CODE"} \
        ${_bprompt:+-F "prompt=$_bprompt"} 2>>"$LOG")"
    rm -f "$_cfg"

    if [ "$_code" != "200" ]; then
        printf '%s: %s\n' "$API_URL" "$(http_explain "$_code")" >&2
        if [ -s "$_body" ]; then
            # Endpoints put the useful detail in the body; scrub before logging
            # in case it echoes the request.
            log "api body: $(head -c 400 "$_body" | scrub)"
            head -c 200 "$_body" | scrub >&2
            printf '\n' >&2
        fi
        rm -f "$_body"
        return 1
    fi
    cat "$_body"
    rm -f "$_body"
}

# Is the local server up? Used by status and doctor so a silently-degraded
# setup — falling back to the CLI on every utterance and just feeling slow —
# is visible rather than guesswork.
server_reachable() {
    "$CURL" -sS --max-time 3 -o /dev/null "${SERVER_URL%/}/" >/dev/null 2>&1
}

# One sentence on where the audio goes, because it is the project's central
# claim and the api backend is the one thing that can make it untrue.
privacy_line() {
    case "$BACKEND" in
        cli)    printf 'audio stays on this machine' ;;
        server) printf 'audio stays on this machine (local server)' ;;
        api)
            if is_loopback_url "$API_URL"; then
                printf 'audio stays on this machine (local endpoint)'
            else
                printf 'AUDIO IS SENT TO %s' "$API_URL"
            fi
            ;;
        *) printf 'unknown backend' ;;
    esac
}

# Dispatch, and the fallback policy. The policy is the point: server may fall
# back to cli because both are local and losing an utterance to a dead daemon
# helps nobody, while api never falls back in either direction — falling back
# FROM it would silently change the result, and falling back TO it would
# silently send audio off the machine.
run_backend() {
    _rwav="$1"; _rprompt="$2"
    case "$BACKEND" in
        cli)
            backend_cli "$_rwav" "$_rprompt"
            ;;
        server)
            if _out="$(backend_server "$_rwav" "$_rprompt")"; then
                printf '%s' "$_out"
            elif [ "$SERVER_FALLBACK" = "1" ]; then
                # Loud in the log, and `doctor` reports server reachability, so
                # a permanently-degraded setup is diagnosable rather than just
                # mysteriously slow.
                log "WARNING: whisper-server unreachable at $SERVER_URL; falling back to the local CLI"
                printf 'whisper-server unreachable; used the local CLI instead\n' >&2
                backend_cli "$_rwav" "$_rprompt"
            else
                return 1
            fi
            ;;
        api)
            backend_api "$_rwav" "$_rprompt"
            ;;
        *)
            printf 'unknown backend: %s (expected cli, server or api)\n' "$BACKEND" >&2
            return 1
            ;;
    esac
}

# Refuse a misconfigured remote backend before recording rather than after, and
# make the off-machine case impossible to enable by accident.
check_backend() {
    case "$BACKEND" in
        cli) require_whisper ;;
        server)
            [ -x "$CURL" ] || die "curl not found at $CURL, which the server backend needs"
            # The fallback runs the local CLI, so that has to be usable too.
            [ "$SERVER_FALLBACK" = "1" ] && require_whisper
            ;;
        api)
            [ -x "$CURL" ] || die "curl not found at $CURL, which the api backend needs"
            if [ -z "$API_KEY" ] && ! is_loopback_url "$API_URL"; then
                die "the api backend needs KEYBIND_API_KEY for a non-local endpoint ($API_URL)"
            fi
            ;;
        *) die "unknown backend: $BACKEND (expected cli, server or api)" ;;
    esac
}

transcribe_wav() {
    _src="$1"
    _label="${2:-audio}"

    # shellcheck disable=SC2046  # splitting is intended: measure() emits 3 fields
    set -- $(measure "$_src")
    _peak="$1"; _rms="$2"; _secs="$3"
    log "$_label: ${_secs}s peak=$_peak rms=$_rms"

    if "$AWK" "BEGIN{exit !(($_secs) < ($MIN_SEC))}"; then
        nothing "capture too short (${_secs}s) — hold the key until you have spoken"
    fi

    # Dead-stream guard. whisper.cpp hallucinates plausible filler on silent
    # audio ("Thank you.", "you", "Thanks for watching"), and macOS hands back
    # a stream of near-zeros when microphone access is denied, or when the
    # selected input is not actually delivering samples. Gate on RMS as well as
    # peak: a dead capture still throws transients past a peak floor, but its
    # RMS stays around 0.00005 while real speech is above 0.002.
    if "$AWK" "BEGIN{exit !(($_peak) < ($PEAK_MIN) || ($_rms) < ($RMS_MIN))}"; then
        nothing "silent capture (peak=$_peak rms=$_rms, need peak>$PEAK_MIN rms>$RMS_MIN) — check the input device and microphone permission; run: keybind-whisper doctor"
    fi

    # Peak-normalize quiet-but-real audio to about -1 dBFS so a low-gain mic
    # lands inside whisper's trained level range.
    if "$SOX" "$_src" "$NORM" norm -1 2>>"$LOG"; then _in="$NORM"; else
        log "normalize failed; using the raw capture"
        _in="$_src"
    fi

    # Bias decoding toward the user's own vocabulary before it ever has to be
    # corrected after the fact. Every backend takes a prompt, so vocabulary
    # works the same wherever transcription happens.
    _vprompt="$(vocab_prompt)"
    [ -n "$_vprompt" ] && log "vocabulary: biasing with ${#_vprompt} characters of terms"

    _raw="$(run_backend "$_in" "$_vprompt")"
    _rc=$?
    rm -f "$NORM"
    # The backend has already explained itself on stderr.
    [ "$_rc" -eq 0 ] || exit 1

    # Strip whisper's non-speech annotations — [BLANK_AUDIO], [SILENCE], and
    # the *music* / *wind* asterisk forms — then flatten to a single line.
    _text="$(printf '%s' "$_raw" \
        | "$TR" -d '\r' \
        | "$SED" -E 's/\[[^]]*\]//g; s/\*[^*]*\*//g' \
        | "$TR" '\n' ' ' \
        | "$SED" -E 's/  +/ /g; s/^ +//; s/ +$//')"

    # Deterministic fix-ups for what the model still gets wrong. Applied before
    # the empty check so a rule may legitimately blank a transcript.
    _before="$_text"
    _text="$(apply_replacements "$_text")"
    [ "$_text" = "$_before" ] || log "replacements applied: [$_before] -> [$_text]"

    [ -n "$_text" ] || nothing "no speech detected (only non-speech markers) in ${_secs}s of audio"

    log "transcript: $_text"
    history_append "$_text" "$_secs" "$_peak" "$_rms" "${HISTORY_SOURCE:-unknown}"
    printf '%s\n' "$_text"
}

# ── Commands ────────────────────────────────────────────────────────────────
cmd_start() {
    require_sox
    log "──── start ────"
    # Never leave two recorders fighting over the same file.
    stop_recorder
    # Delete the previous capture BEFORE recording. Without this, a start that
    # fails to open the device leaves the last run's audio in place and `stop`
    # transcribes stale speech as though it were just spoken.
    rm -f "$WAV" "$NORM"
    printf '%s\n' "${DEVICE:-system default input}" > "$DEVFILE"

    spawn_recorder
    _pid="$REC_PID"
    printf '%s\n' "$_pid" > "$PIDFILE"

    # Confirm the recorder actually came up. sox exits immediately when the
    # device is unavailable or microphone access is blocked; reporting success
    # anyway would surface the failure only as an empty transcript later.
    _i=0
    while [ "$_i" -lt 30 ]; do
        if ! kill -0 "$_pid" 2>/dev/null; then
            rm -f "$PIDFILE"
            die "recorder exited immediately (${DEVICE:-system default input}). Recent log: $(tail -n 3 "$LOG" 2>/dev/null | "$TR" '\n' ' ')"
        fi
        [ -s "$WAV" ] && { log "recorder up (pid=$_pid)"; return 0; }
        /bin/sleep 0.05
        _i=$((_i + 1))
    done
    # Alive but nothing on disk yet: sox sometimes buffers the header. Let it run.
    log "recorder pid=$_pid alive, no bytes after 1.5s; continuing"
}

cmd_stop() {
    require_sox
    check_backend
    log "──── stop ────"

    _was_recording=0
    [ -f "$PIDFILE" ] && _was_recording=1
    stop_recorder

    if [ "$_was_recording" -eq 0 ]; then
        # No recorder was running, so anything on disk is stale by definition.
        # Transcribing it would emit text the user never just spoke.
        rm -f "$WAV" "$NORM"
        die "stop called with no recording in progress"
    fi

    [ -s "$WAV" ] || nothing "no audio captured — the recorder produced an empty file"
    HISTORY_SOURCE="mic"
    transcribe_wav "$WAV" "capture from $(cat "$DEVFILE" 2>/dev/null)"
}

# One-shot dictation: record, wait for the recording to end, transcribe. This
# is the mode auto-stop needs, because something has to be waiting for the
# recorder to finish on its own. It ends when any of these happens:
#   - speech stops for SILENCE_SEC (when auto-stop is enabled)
#   - MAX_SEC is reached
#   - `keybind-whisper finish` signals the recorder from elsewhere
cmd_dictate() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --silence) shift; SILENCE_SEC="${1:-0}" ;;
            *) die "unknown option for dictate: $1" ;;
        esac
        shift
    done
    require_sox
    check_backend
    log "──── dictate ────"
    stop_recorder
    rm -f "$WAV" "$NORM"
    printf '%s\n' "${DEVICE:-system default input}" > "$DEVFILE"

    spawn_recorder
    printf '%s\n' "$REC_PID" > "$PIDFILE"
    if [ "$SILENCE_SEC" = "0" ]; then
        log "dictate: auto-stop disabled; waiting for 'finish' or the ${MAX_SEC}s cap"
    fi

    # A signal-terminated recorder makes wait return non-zero, which is a
    # normal ending here, not a failure.
    rm -f "$TRANSCRIBING"
    wait "$REC_PID" 2>/dev/null
    rm -f "$PIDFILE"
    # The recorder has stopped and the model is about to run. A front end polls
    # for this file to switch its indicator, which costs it a stat() rather
    # than spawning a process every half second.
    : > "$TRANSCRIBING"

    [ -s "$WAV" ] || nothing "no audio captured — nothing was above the silence threshold ($SILENCE_THRESHOLD), or the input is not delivering audio"
    HISTORY_SOURCE="mic"
    transcribe_wav "$WAV" "dictate from $(cat "$DEVFILE" 2>/dev/null)"
    rm -f "$TRANSCRIBING"
}

# End a recording without transcribing it. The `dictate` process that owns the
# recorder notices it exit and does the transcription itself, so this is how a
# hotkey stops dictation early without racing for the same audio.
cmd_finish() {
    [ -f "$PIDFILE" ] || die "no recording in progress"
    stop_recorder
    log "finished by request"
}

cmd_toggle() {
    if recorder_alive "$(current_pid)"; then cmd_stop; else cmd_start; fi
}

cmd_transcribe() {
    [ -n "${1:-}" ] || die "usage: keybind-whisper transcribe FILE"
    [ -f "$1" ] || die "no such file: $1"
    require_sox
    check_backend
    log "──── transcribe $1 ────"
    # Convert whatever was handed in to whisper's native format first, so any
    # sox-readable file works regardless of rate, channels or container.
    _conv="$STATE_DIR/input.wav"
    "$SOX" "$1" -r 16000 -c 1 -b 16 "$_conv" 2>>"$LOG" \
        || die "could not read audio file: $1 (see $LOG)"
    HISTORY_SOURCE="$1"
    transcribe_wav "$_conv" "file $1"
    rm -f "$_conv"
}

# Preview the replacement rules against arbitrary text. Authoring rules blind
# and discovering the mistake in a real dictation is the slow way round.
cmd_replace() {
    if [ -n "${1:-}" ]; then _t="$1"; else _t="$(cat)"; fi
    apply_replacements "$_t"
    printf '\n'
}

# Start the local server the `server` backend talks to. Without this the fast
# path means hand-assembling a whisper-server command with the right model and
# port, which is enough friction that people simply stay on the slow default.
cmd_serve() {
    require_sox
    [ -n "$WHISPER" ] || die "whisper-cli not found, so whisper-server is probably not built either"
    [ -n "$MODEL" ] || die "no usable model found — set KEYBIND_MODEL"
    if _why="$(model_problem "$MODEL")"; then
        die "the configured model is unusable ($_why): $MODEL"
    fi

    _srvbin="$(dirname "$WHISPER")/whisper-server"
    [ -x "$_srvbin" ] || die "whisper-server not found next to whisper-cli at $_srvbin — rebuild whisper.cpp"

    # The port has to agree with what the backend will dial, so take it from
    # the same setting rather than inventing a second source of truth.
    _port="$(printf '%s' "$SERVER_URL" | "$SED" -nE 's|^[a-z]+://[^:/]+:([0-9]+).*$|\1|p')"
    [ -n "$_port" ] || _port=8080

    if server_reachable; then
        die "something is already listening at $SERVER_URL"
    fi

    printf 'Starting whisper-server on port %s with %s\n' "$_port" "$(basename "$MODEL")"
    printf 'Leave this running, and set KEYBIND_BACKEND=server. Ctrl-C to stop.\n\n'
    exec "$_srvbin" -m "$MODEL" --port "$_port" -l "$LANG_CODE"
}

# List every model found, which is selected, and why anything was rejected.
# With a shared store the question "which weights is this actually using?"
# stops being obvious, and a silently-skipped corrupt file should be visible.
cmd_models() {
    printf 'Shared store: %s%s\n\n' "$MODELS_DIR" \
        "$([ -d "$MODELS_DIR" ] || printf '  (does not exist yet)')"
    _selected="${MODEL:-}"
    _any=0
    while IFS= read -r _f; do
        [ -f "$_f" ] || continue
        _any=1
        _mb=$(( $(/usr/bin/stat -f%z "$_f" 2>/dev/null || echo 0) / 1048576 ))
        if _why="$(model_problem "$_f")"; then
            printf '  %-9s %5s MB  %s\n' "UNUSABLE" "$_mb" "$_f"
            printf '  %-9s           %s\n' "" "$_why"
        elif [ "$_f" = "$_selected" ]; then
            printf '  %-9s %5s MB  %s\n' "IN USE" "$_mb" "$_f"
        else
            printf '  %-9s %5s MB  %s\n' "ok" "$_mb" "$_f"
        fi
    done <<EOF
$(model_search_globs)
EOF
    [ "$_any" -eq 1 ] || printf '  no models found\n'
    printf '\nTo add one, put it in its own directory under the store:\n'
    printf '  mkdir -p %s/whisper-large-v3-turbo\n' "$MODELS_DIR"
    printf '  mv ggml-large-v3-turbo.bin %s/whisper-large-v3-turbo/\n' "$MODELS_DIR"
}

cmd_status() {
    printf 'keybind-whisper %s\n\n' "$KEYBIND_VERSION"
    printf '  backend   %s  (%s)\n' "$BACKEND" "$(privacy_line)"
    case "$BACKEND" in
        server)
            printf '  server    %s  %s\n' "$SERVER_URL" \
                "$(server_reachable && printf 'up' || printf 'DOWN%s' "$([ "$SERVER_FALLBACK" = 1 ] && printf ' — falling back to the CLI on every utterance')")"
            ;;
        api)
            printf '  endpoint  %s\n' "$API_URL"
            printf '  api model %s\n' "$API_MODEL"
            printf '  api key   %s\n' "$([ -n "$API_KEY" ] && printf 'set' || printf 'not set')"
            ;;
    esac
    printf '  sox       %s\n' "${SOX:-NOT FOUND}"
    printf '  whisper   %s\n' "${WHISPER:-NOT FOUND}"
    if [ -n "$MODEL" ] && _why="$(model_problem "$MODEL")"; then
        printf '  model     %s  (%s)\n' "$MODEL" "$_why"
    else
        printf '  model     %s\n' "${MODEL:-NOT FOUND}"
    fi
    printf '  input     %s\n' "${DEVICE:-system default}"
    printf '  language  %s\n' "$LANG_CODE"
    if [ "$SILENCE_SEC" = "0" ]; then
        printf '  auto-stop off (push-to-talk)\n'
    else
        printf '  auto-stop %ss below %s\n' "$SILENCE_SEC" "$SILENCE_THRESHOLD"
    fi
    printf '  vocab     %s\n' "$([ -s "$VOCAB_FILE" ] && printf '%s' "$VOCAB_FILE" || printf 'none')"
    printf '  replace   %s\n' "$([ -s "$REPLACEMENTS_FILE" ] && printf '%s' "$REPLACEMENTS_FILE" || printf 'none')"
    printf '  config    %s%s\n' "$CONFIG_FILE" "$([ -r "$CONFIG_FILE" ] && echo '' || echo '  (none)')"
    printf '  state     %s\n' "$STATE_DIR"
    printf '  log       %s\n' "$LOG"
    _pid="$(current_pid)"
    if recorder_alive "$_pid"; then
        printf '  recording YES (pid %s)\n' "$_pid"
    elif [ -f "$PIDFILE" ]; then
        printf '  recording no (stale pidfile: %s)\n' "$_pid"
    else
        printf '  recording no\n'
    fi
}

cmd_doctor() {
    _rc=0
    printf 'Dependencies\n'
    if [ -n "$SOX" ]; then printf '  ok    sox       %s\n' "$SOX"
    else printf '  FAIL  sox not found — brew install sox\n'; _rc=1; fi

    # A remote backend needs neither whisper-cli nor a model, so report them as
    # not-required rather than as failures.
    _need_local=1
    [ "$BACKEND" = "api" ] && _need_local=0
    [ "$BACKEND" = "server" ] && [ "$SERVER_FALLBACK" != "1" ] && _need_local=0

    if [ -n "$WHISPER" ]; then printf '  ok    whisper   %s\n' "$WHISPER"
    elif [ "$_need_local" -eq 0 ]; then printf '  --    whisper   not needed for the %s backend\n' "$BACKEND"
    else printf '  FAIL  whisper-cli not found — build whisper.cpp or set KEYBIND_WHISPER_BIN\n'; _rc=1; fi

    if [ -n "$MODEL" ] && _why="$(model_problem "$MODEL")"; then
        printf '  FAIL  model     %s\n' "$MODEL"
        printf '        %s\n' "$_why"
        printf '        re-download it, or point KEYBIND_MODEL at a good one\n'
        [ "$_need_local" -eq 1 ] && _rc=1
    elif [ -n "$MODEL" ]; then
        printf '  ok    model     %s\n' "$MODEL"
    elif [ "$_need_local" -eq 0 ]; then
        printf '  --    model     not needed for the %s backend\n' "$BACKEND"
    else
        printf '  FAIL  no usable model found — set KEYBIND_MODEL\n'; _rc=1
    fi

    printf '\nBackend\n'
    printf '  %s — %s\n' "$BACKEND" "$(privacy_line)"
    case "$BACKEND" in
        server)
            if server_reachable; then
                printf '  ok    whisper-server is up at %s\n' "$SERVER_URL"
            else
                printf '  FAIL  no whisper-server at %s\n' "$SERVER_URL"
                if [ "$SERVER_FALLBACK" = "1" ]; then
                    printf '        every utterance is falling back to the CLI, which is ~3.7x slower\n'
                fi
                printf '        start one with:\n'
                printf '          %s -m %s --port %s\n' \
                    "$(dirname "${WHISPER:-whisper-cli}")/whisper-server" "${MODEL:-MODEL}" \
                    "$(printf '%s' "$SERVER_URL" | "$SED" -E 's|.*:([0-9]+).*|\1|')"
                _rc=1
            fi
            ;;
        api)
            # Deliberately NOT a live request: a diagnostic must not spend the
            # user's money or ship their audio anywhere as a side effect.
            if [ -n "$API_KEY" ]; then
                printf '  ok    an API key is set\n'
            elif is_loopback_url "$API_URL"; then
                printf '  ok    no key needed for a local endpoint\n'
            else
                printf '  FAIL  KEYBIND_API_KEY is not set for %s\n' "$API_URL"; _rc=1
            fi
            is_loopback_url "$API_URL" || \
                printf '  note  your audio is uploaded to this endpoint on every dictation\n'
            printf '  note  no request was made; doctor does not send audio or spend credit\n'
            ;;
    esac

    printf '\nAudio input\n'
    if [ -n "$SWITCHAUDIO" ]; then
        printf '  system default: %s\n' "$("$SWITCHAUDIO" -c -t input 2>/dev/null)"
        printf '  available:\n'
        "$SWITCHAUDIO" -a -t input 2>/dev/null | "$SED" 's/^/    /'
    else
        printf '  (install switchaudio-osx to list devices: brew install switchaudio-osx)\n'
    fi
    printf '  configured: %s\n' "${DEVICE:-system default}"

    [ "$_rc" -eq 0 ] || { printf '\nDependencies are missing; skipping the microphone test.\n'; return 1; }

    if recorder_alive "$(current_pid)"; then
        printf '\nA recording is in progress; skipping the microphone test.\n'
        printf 'Finish dictating, then run doctor again.\n'
        return "$_rc"
    fi

    printf '\nMicrophone test — recording 3 seconds from %s.\n' "${DEVICE:-the system default input}"
    printf 'Say something now.\n'
    _t="$STATE_DIR/doctor.wav"
    rm -f "$_t"
    if [ -n "$DEVICE" ]; then
        "$SOX" -q -t coreaudio "$DEVICE" -r 16000 -c 1 -b 16 "$_t" trim 0 3 2>&1
    else
        "$SOX" -q -d -r 16000 -c 1 -b 16 "$_t" trim 0 3 2>&1
    fi
    [ -s "$_t" ] || { printf '  FAIL  no audio was captured at all.\n'; return 1; }
    # shellcheck disable=SC2046  # splitting is intended: measure() emits 3 fields
    set -- $(measure "$_t")
    printf '  levels: peak=%s rms=%s duration=%ss\n' "$1" "$2" "$3"
    if "$AWK" "BEGIN{exit !(($1) < ($PEAK_MIN) || ($2) < ($RMS_MIN))}"; then
        printf '  FAIL  this input reads as dead (need peak>%s rms>%s).\n' "$PEAK_MIN" "$RMS_MIN"
        printf '        - Check System Settings > Privacy & Security > Microphone and\n'
        printf '          make sure the app that launches keybind-whisper is allowed.\n'
        printf '        - Check System Settings > Sound > Input and pick a working device.\n'
        printf '        - Bluetooth headsets often expose a silent input until macOS\n'
        printf '          switches them to their headset profile; try a wired or built-in mic.\n'
        _rc=1
    else
        printf '  ok    input is live\n'
    fi
    # Turn the measured peak into a silence threshold the user can paste in.
    # The threshold has to sit above room noise and below speech; halfway
    # between the two on a log scale is the safest single number.
    "$AWK" -v peak="$1" '
        BEGIN {
            pct = peak * 100
            printf "  speech peaked at %.2f%% of full scale\n", pct
            if (pct > 0.2) {
                rec = pct / 4
                if (rec < 0.3) rec = 0.3
                printf "  for auto-stop, try: KEYBIND_SILENCE_THRESHOLD=\"%.1f%%\"\n", rec
            }
        }'

    printf '\nVocabulary and replacements\n'
    if [ -s "$VOCAB_FILE" ]; then
        printf '  %s terms in %s\n' "$("$SED" -e 's/#.*$//' "$VOCAB_FILE" | "$AWK" 'NF' | /usr/bin/wc -l | "$TR" -d ' ')" "$VOCAB_FILE"
    else
        printf '  no vocabulary file (%s)\n' "$VOCAB_FILE"
    fi
    if [ -s "$REPLACEMENTS_FILE" ]; then
        printf '  %s rules in %s\n' "$("$SED" -e 's/#.*$//' "$REPLACEMENTS_FILE" | "$AWK" '/=/' | /usr/bin/wc -l | "$TR" -d ' ')" "$REPLACEMENTS_FILE"
    else
        printf '  no replacements file (%s)\n' "$REPLACEMENTS_FILE"
    fi

    rm -f "$_t"
    return "$_rc"
}

cmd_history() {
    _sub="${1:-list}"
    shift 2>/dev/null

    case "$_sub" in
        list|"")
            history_require
            _n="${1:-20}"
            case "$_n" in ''|*[!0-9]*) die "usage: keybind-whisper history list [COUNT]" ;; esac
            # Numbered newest-first, so the index matches `history show N`.
            tail -n "$_n" "$HISTORY_FILE" | "$AWK" "$AWK_UNESCAPE"'
                { lines[NR] = $0 }
                END {
                    for (i = NR; i >= 1; i--) {
                        idx = NR - i + 1
                        ts = field(lines[i], "ts")
                        sub(/T/, " ", ts); sub(/[+-][0-9]{4}$/, "", ts)
                        t = textof(lines[i])
                        if (length(t) > 68) t = substr(t, 1, 65) "..."
                        printf "%4d  %s  %s\n", idx, ts, t
                    }
                }'
            ;;

        add)
            # Record a transcription that did not come from this tool. Useful
            # for importing history from elsewhere, and for scripting.
            if [ -n "${1:-}" ]; then _t="$1"; else _t="$(cat)"; fi
            # Flatten exactly as a real transcript is flattened, so imported
            # entries are indistinguishable in shape from recorded ones.
            _t="$(printf '%s' "$_t" | "$TR" '\n' ' ' | "$SED" -E 's/  +/ /g; s/^ +//; s/ +$//')"
            [ -n "$_t" ] || die "nothing to add"
            HISTORY_SOURCE="${2:-import}"
            history_append "$_t" "0" "0" "0" "$HISTORY_SOURCE"
            printf 'added %s characters to history\n' "$(printf '%s' "$_t" | /usr/bin/wc -c | "$TR" -d ' ')" >&2
            ;;

        show)
            history_require
            history_text_at "${1:-1}"
            ;;

        last)
            history_require
            history_text_at 1
            ;;

        copy)
            history_require
            _t="$(history_text_at "${1:-1}")" || exit 1
            printf '%s' "$_t" | /usr/bin/pbcopy
            printf 'copied %s characters to the clipboard\n' "$(printf '%s' "$_t" | /usr/bin/wc -c | "$TR" -d ' ')" >&2
            ;;

        search)
            history_require
            [ -n "${1:-}" ] || die "usage: keybind-whisper history search QUERY"
            # Case-insensitive substring match against the transcript text only,
            # so metadata fields cannot produce spurious hits.
            "$AWK" -v q="$1" "$AWK_UNESCAPE"'
                { lines[NR] = $0 }
                END {
                    n = 0
                    for (i = NR; i >= 1; i--) {
                        t = textof(lines[i])
                        if (index(tolower(t), tolower(q)) == 0) continue
                        idx = NR - i + 1
                        ts = field(lines[i], "ts")
                        sub(/T/, " ", ts); sub(/[+-][0-9]{4}$/, "", ts)
                        if (length(t) > 68) t = substr(t, 1, 65) "..."
                        printf "%4d  %s  %s\n", idx, ts, t
                        n++
                    }
                    if (n == 0) { print "no matches" > "/dev/stderr"; exit 1 }
                }' "$HISTORY_FILE"
            ;;

        stats)
            history_require
            "$AWK" "$AWK_UNESCAPE"'
                { n++; c += length(textof($0)); s += field($0, "seconds") + 0
                  if (n == 1) first = field($0, "ts") }
                END {
                    sub(/T/, " ", first); sub(/[+-][0-9]{4}$/, "", first)
                    printf "  entries    %d\n", n
                    printf "  since      %s\n", first
                    printf "  characters %d\n", c
                    printf "  audio      %.1f minutes\n", s / 60
                    if (n > 0) printf "  average    %d characters per dictation\n", c / n
                }' "$HISTORY_FILE"
            ;;

        export)
            history_require
            cat "$HISTORY_FILE"
            ;;

        path)
            printf '%s\n' "$HISTORY_FILE"
            ;;

        clear)
            [ -s "$HISTORY_FILE" ] || die "no history to clear"
            _count="$(/usr/bin/wc -l < "$HISTORY_FILE" | "$TR" -d ' ')"
            # Destructive and unrecoverable, so require an explicit --yes rather
            # than prompting: this is often run from a hotkey with no terminal.
            if [ "${1:-}" != "--yes" ]; then
                die "this deletes $_count stored transcriptions permanently. Re-run: keybind-whisper history clear --yes"
            fi
            rm -f "$HISTORY_FILE"
            printf 'deleted %s stored transcriptions\n' "$_count" >&2
            ;;

        *)
            die "unknown history command: $_sub (try: list, show, last, copy, search, add, stats, export, path, clear)"
            ;;
    esac
}

usage() {
    cat <<'USAGE'
keybind-whisper — offline push-to-talk dictation for macOS

  keybind-whisper start               begin recording
  keybind-whisper stop                finish recording, print the transcript
  keybind-whisper toggle              start if idle, stop if recording
  keybind-whisper dictate [--silence N]
                                    record until you stop speaking, then print
  keybind-whisper finish              end a recording without transcribing it
  keybind-whisper transcribe FILE     transcribe an existing audio file

  keybind-whisper history [list [N]]  recent transcriptions, newest first
  keybind-whisper history show N      print entry N in full (1 = most recent)
  keybind-whisper history last        print the most recent transcription
  keybind-whisper history copy [N]    copy entry N to the clipboard
  keybind-whisper history search Q    find past transcriptions containing Q
  keybind-whisper history add TEXT    record a transcription from elsewhere
  keybind-whisper replace TEXT        preview your replacement rules on TEXT
  keybind-whisper history stats       how much has been dictated
  keybind-whisper history export      raw JSONL on stdout
  keybind-whisper history path        where history is stored
  keybind-whisper history clear --yes delete all stored transcriptions

  keybind-whisper models              list the models found, and which is in use
  keybind-whisper serve               run the local server the fast backend uses
  keybind-whisper status              current state and resolved configuration
  keybind-whisper doctor              check dependencies and test the microphone
  keybind-whisper version             print the version

Audio is captured from the system default input and transcribed locally.
Nothing leaves the machine.
USAGE
}

case "${1:-}" in
    start)       cmd_start ;;
    stop)        cmd_stop ;;
    toggle)      cmd_toggle ;;
    dictate)     shift; cmd_dictate "$@" ;;
    finish)      cmd_finish ;;
    transcribe)  shift; cmd_transcribe "${1:-}" ;;
    history)     shift; cmd_history "$@" ;;
    replace)     shift; cmd_replace "${1:-}" ;;
    models)      cmd_models ;;
    serve)       cmd_serve ;;
    status)      cmd_status ;;
    doctor)      cmd_doctor ;;
    version|--version|-v) printf 'keybind-whisper %s\n' "$KEYBIND_VERSION" ;;
    help|--help|-h) usage ;;
    *)           usage >&2; exit 2 ;;
esac
